---
/**
 * Rendered Note content region (task 17.3; Req 3.1, 3.8, 6.1).
 *
 * Wraps the sanitized Markdown output (the `Content` component produced by
 * Astro's `render()`, already run through the KaTeX/Shiki/sanitize pipeline)
 * in the search-indexed body region. The region is marked `data-pagefind-body`
 * so Pagefind indexes it, and carries the Display_Name (as the page `h1`) and
 * the Category path as Pagefind meta + searchable text (Req 6.1, 6.7). The
 * `./image-fallback` island supplies alt/placeholder fallback for broken
 * images (Req 3.8). The `./code-block` and `./image-zoom` islands add the
 * Tier-2 reading polish (code copy button + language label; image captions +
 * click-to-zoom lightbox) as progressive, client-side enhancements.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

/** One resolved prerequisite: its label and (if it maps to a note) its route. */
export interface PrereqLink {
  label: string;
  href: string | null;
}
type Difficulty = 'beginner' | 'intermediate' | 'advanced';

interface Props {
  /** The Note Display_Name, rendered as the page title heading. */
  displayName: string;
  /** Human-readable Category path, e.g. "AI-ML / SelfNotes". */
  categoryPath: string;
  /** The rendered Markdown component from `render(entry)`. */
  Content: AstroComponentFactory;
  /** This note's route, e.g. `/notes/.../classes-objects`. Keys the progress
   *  store so the "Mark as complete" control stays in sync with the roadmap. */
  route: string;
  /** Optional material difficulty (frontmatter), shown as a badge. */
  difficulty?: Difficulty;
  /** Optional prerequisites (frontmatter), resolved to links where possible. */
  prerequisites?: PrereqLink[];
}

const { displayName, categoryPath, Content, route, difficulty, prerequisites = [] } = Astro.props;

// Difficulty badge palette: a distinct axis from the roadmap's core/advanced
// tier, so it uses its own green -> blue -> pink scale.
const DIFFICULTY: Record<Difficulty, { label: string; dot: string; pill: string }> = {
  beginner: {
    label: 'Beginner',
    dot: 'bg-emerald-500',
    pill: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300',
  },
  intermediate: {
    label: 'Intermediate',
    dot: 'bg-blue-500',
    pill: 'bg-blue-100 text-blue-700 dark:bg-blue-500/15 dark:text-blue-300',
  },
  advanced: {
    label: 'Advanced',
    dot: 'bg-pink-500',
    pill: 'bg-pink-100 text-pink-700 dark:bg-pink-500/15 dark:text-pink-300',
  },
};
const diff = difficulty ? DIFFICULTY[difficulty] : null;
---

<article data-pagefind-body class="min-w-0">
  <h1 data-pagefind-meta="displayName" class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
    {displayName}
  </h1>

  {/* Meta line: category, difficulty badge, then prerequisites (option 4A). */}
  {
    (categoryPath || diff) && (
      <div class="mt-2 flex flex-wrap items-center gap-2">
        {categoryPath && (
          <span class="text-sm text-gray-500 dark:text-gray-400" data-pagefind-meta="categoryPath">
            {categoryPath}
          </span>
        )}
        {diff && (
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold',
              diff.pill,
            ]}
          >
            <span class:list={['h-1.5 w-1.5 rounded-full', diff.dot]} aria-hidden="true" />
            {diff.label}
          </span>
        )}
      </div>
    )
  }

  {
    prerequisites.length > 0 && (
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Prerequisites:</span>{' '}
        {prerequisites.map((p, i) => (
          <>
            {i > 0 && ', '}
            {p.href ? (
              <a
                href={p.href}
                class="text-accent-700 underline decoration-accent-300 underline-offset-2 hover:text-accent-800 dark:text-accent-300 dark:decoration-accent-500 dark:hover:text-accent-200"
              >
                {p.label}
              </a>
            ) : (
              <span
                title={`${p.label} - coming soon`}
                class="text-gray-400 underline decoration-dashed decoration-gray-300 underline-offset-2 dark:text-gray-500 dark:decoration-gray-600"
              >
                {p.label}
                <span class="text-xs text-gray-400 dark:text-gray-500"> (soon)</span>
              </span>
            )}
          </>
        ))}
      </p>
    )
  }

  <div class="note-body mt-6">
    <Content />
  </div>

  {/*
    Progress control (option B2), placed at the END of the reading flow — the
    natural "you've finished, mark it done" moment, after the body and before
    the backlinks / prev-next navigation. A quiet divider sets it apart from the
    content. State lives in the shared progress store (keyed by this note's
    route), so the roadmap graph, modal, and meter stay in sync. Enhanced by the
    `./note-progress` island, which reflects any state saved on a previous visit.
  */}
  <div
    class="mt-10 flex flex-col items-center gap-3 border-t border-gray-200 pt-6 text-center dark:border-white/10"
    data-note-progress
    data-route={route}
  >
    <p class="text-sm text-gray-500 dark:text-gray-400">Finished this note?</p>
    <button
      type="button"
      data-note-progress-input
      aria-pressed="false"
      class="note-progress-btn inline-flex items-center gap-2.5 rounded-lg border-[1.75px] border-emerald-500 px-4 py-2 text-sm font-semibold text-emerald-600 transition-colors hover:bg-emerald-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 focus-visible:ring-offset-2 dark:text-emerald-400 dark:hover:bg-emerald-500/10 dark:focus-visible:ring-offset-gray-900"
    >
      <span
        data-note-progress-icon
        aria-hidden="true"
        class="inline-flex h-[17px] w-[17px] items-center justify-center rounded-full border-2 border-current"
      ></span>
      <span data-note-progress-label>Mark as complete</span>
    </button>
  </div>
</article>

<style>
  /* Done state for the "Mark as complete" control: the ghost outline flips to a
     solid green fill with a tick, matching the roadmap modal's "Mark done"
     button. The island adds `.is-done` when this note's route is complete. */
  .note-progress-btn.is-done {
    background-color: #10b981;
    border-color: #10b981;
    color: #042f1f;
  }
  .note-progress-btn.is-done:hover {
    background-color: #059669;
    border-color: #059669;
  }
  :global([data-theme='dark']) .note-progress-btn.is-done {
    background-color: #34d399;
    border-color: #34d399;
    color: #042f1f;
  }
</style>

<script>
  import './image-fallback';
  import './code-block';
  import './image-zoom';
  import './search-highlight';
  import './note-progress';
</script>
