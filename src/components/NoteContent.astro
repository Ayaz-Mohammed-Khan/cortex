---
/**
 * Rendered Note content region (task 17.3; Req 3.1, 3.8, 6.1).
 *
 * Wraps the sanitized Markdown output (the `Content` component produced by
 * Astro's `render()`, already run through the KaTeX/Shiki/sanitize pipeline)
 * in the search-indexed body region. The region is marked `data-pagefind-body`
 * so Pagefind indexes it, and carries the Display_Name (as the page `h1`) and
 * the Category path as Pagefind meta + searchable text (Req 6.1, 6.7). The
 * `./image-fallback` island supplies alt/placeholder fallback for broken
 * images (Req 3.8). The `./code-block` and `./image-zoom` islands add the
 * Tier-2 reading polish (code copy button + language label; image captions +
 * click-to-zoom lightbox) as progressive, client-side enhancements.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { Quiz } from '@/lib/quiz';

/** One resolved prerequisite: its label and (if it maps to a note) its route. */
export interface PrereqLink {
  label: string;
  href: string | null;
}
type Difficulty = 'beginner' | 'intermediate' | 'advanced';

interface Props {
  /** The Note Display_Name, rendered as the page title heading. */
  displayName: string;
  /** Human-readable Category path, e.g. "AI-ML / SelfNotes". */
  categoryPath: string;
  /** The rendered Markdown component from `render(entry)`. */
  Content: AstroComponentFactory;
  /** This note's route, e.g. `/notes/.../classes-objects`. Keys the progress
   *  store so the "Mark as complete" control stays in sync with the roadmap. */
  route: string;
  /** Optional material difficulty (frontmatter), shown as a badge. */
  difficulty?: Difficulty;
  /** Optional prerequisites (frontmatter), resolved to links where possible. */
  prerequisites?: PrereqLink[];
  /** This note's quiz, when one exists; drives the "Test yourself" banner. */
  quiz?: Quiz | null;
}

const {
  displayName,
  categoryPath,
  Content,
  route,
  difficulty,
  prerequisites = [],
  quiz = null,
} = Astro.props;

// Size of the whole question POOL. Zero means no banner is shown.
const quizPool = quiz?.questions.length ?? 0;

// A graded attempt samples a stratified SUBSET of the pool, not the whole bank,
// so the banner's test length, time, and pass mark must describe that subset,
// not the pool. This mirrors `gradedCount` in `src/components/quiz.ts`: about
// half the pool, bounded to [6, 8]. Keep both in sync.
const GRADED_MIN = 6;
const GRADED_MAX = 8;
const quizCount =
  quizPool > 0 ? Math.max(GRADED_MIN, Math.min(GRADED_MAX, Math.min(Math.round(quizPool / 2), quizPool))) : 0;

// Timed budget estimate: the pool's average per-question allowance times the
// sampled count (the exact subset is not known until the attempt samples, so
// this is an estimate, deliberately rounded to a "~N min"). Per-type seconds
// kept in sync with SECONDS_PER_TYPE in `src/components/quiz.ts`.
const QUIZ_SECONDS_PER_TYPE: Record<string, number> = { mcq: 45, scenario: 75, card: 60 };
const quizPoolSeconds =
  quiz?.questions.reduce((s, q) => s + (QUIZ_SECONDS_PER_TYPE[q.type] ?? 60), 0) ?? 0;
const quizSeconds = quizPool > 0 ? Math.round((quizPoolSeconds / quizPool) * quizCount) : 0;
const quizMinutes = quizSeconds > 0 ? Math.max(1, Math.round(quizSeconds / 60)) : 0;
// Pass threshold: two thirds correct of the SAMPLED count. Kept in sync with
// PASS_RATIO in `src/components/quiz.ts`.
const quizPassMark = quizCount > 0 ? Math.ceil((quizCount * 2) / 3) : 0;

// Difficulty badge palette: a distinct axis from the roadmap's core/advanced
// tier, so it uses its own green -> blue -> pink scale.
const DIFFICULTY: Record<Difficulty, { label: string; dot: string; pill: string }> = {
  beginner: {
    label: 'Beginner',
    dot: 'bg-emerald-500',
    pill: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300',
  },
  intermediate: {
    label: 'Intermediate',
    dot: 'bg-blue-500',
    pill: 'bg-blue-100 text-blue-700 dark:bg-blue-500/15 dark:text-blue-300',
  },
  advanced: {
    label: 'Advanced',
    dot: 'bg-pink-500',
    pill: 'bg-pink-100 text-pink-700 dark:bg-pink-500/15 dark:text-pink-300',
  },
};
const diff = difficulty ? DIFFICULTY[difficulty] : null;
---

<article data-pagefind-body class="min-w-0">
  <h1 data-pagefind-meta="displayName" class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
    {displayName}
  </h1>

  {/* Meta line: category, difficulty badge, then prerequisites (option 4A). */}
  {
    (categoryPath || diff) && (
      <div class="mt-2 flex flex-wrap items-center gap-2">
        {categoryPath && (
          <span class="text-sm text-gray-500 dark:text-gray-400" data-pagefind-meta="categoryPath">
            {categoryPath}
          </span>
        )}
        {diff && (
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold',
              diff.pill,
            ]}
          >
            <span class:list={['h-1.5 w-1.5 rounded-full', diff.dot]} aria-hidden="true" />
            {diff.label}
          </span>
        )}
      </div>
    )
  }

  {
    prerequisites.length > 0 && (
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Prerequisites:</span>{' '}
        {prerequisites.map((p, i) => (
          <>
            {i > 0 && ', '}
            {p.href ? (
              <a
                href={p.href}
                class="text-accent-700 underline decoration-accent-300 underline-offset-2 hover:text-accent-800 dark:text-accent-300 dark:decoration-accent-500 dark:hover:text-accent-200"
              >
                {p.label}
              </a>
            ) : (
              <span
                title={`${p.label} - coming soon`}
                class="text-gray-400 underline decoration-dashed decoration-gray-300 underline-offset-2 dark:text-gray-500 dark:decoration-gray-600"
              >
                {p.label}
                <span class="text-xs text-gray-400 dark:text-gray-500"> (soon)</span>
              </span>
            )}
          </>
        ))}
      </p>
    )
  }

  <div class="note-body mt-6">
    <Content />
  </div>

  {/*
    Quiz entry banner. Shown only when this note has a companion quiz. It is a
    quiet call-to-action (a container with an explicit Start button, not a
    whole-card click target), sitting after the body and before "Mark as
    complete" so the flow reads: read the note, test yourself, mark it done. The
    `./quiz` island reads the serialized quiz below and opens the modal.
  */}
  {quizPool > 0 && (
    <div
      class="mt-10 flex flex-col gap-4 rounded-2xl border border-accent-200 bg-accent-50/60 px-5 py-4 sm:flex-row sm:flex-wrap sm:items-center dark:border-accent-500/25 dark:bg-accent-500/10"
      data-quiz-banner
    >
      <span
        aria-hidden="true"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent-100 text-accent-600 dark:bg-accent-500/20 dark:text-accent-300"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 11l3 3L22 4" />
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-gray-900 dark:text-gray-100">Test yourself</p>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          <strong class="font-semibold text-gray-700 dark:text-gray-300">Quiz me</strong> is a timed test of {quizCount} questions drawn from a pool of {quizPool} (~{quizMinutes} {quizMinutes === 1 ? 'min' : 'mins'}, score {quizPassMark}+ to complete the note; miss it and it locks until review). Each attempt is a fresh mix. <strong class="font-semibold text-gray-700 dark:text-gray-300">Flashcards</strong> is untimed recall practice over the whole pool.
        </p>
      </div>
      <div class="flex shrink-0 gap-2">
        {/* Recall practice: same questions, options hidden, not graded. */}
        <button
          type="button"
          data-quiz-start="flashcards"
          class="inline-flex items-center gap-1.5 rounded-lg border-[1.75px] border-accent-500 px-3.5 py-2 text-sm font-semibold text-accent-700 transition-colors hover:bg-accent-500/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 dark:border-accent-400 dark:text-accent-200 dark:focus-visible:ring-offset-gray-900"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="6" width="13" height="12" rx="2" /><path d="M20 9v9a2 2 0 0 1-2 2H8" opacity="0.5" />
          </svg>
          Flashcards
        </button>
        {/* Graded quiz: recognition, gates completion. The island disables and
            relabels this when the quiz is locked after a recent fail. */}
        <button
          type="button"
          data-quiz-start="quiz"
          data-quiz-cta
          class="inline-flex items-center gap-1.5 rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:bg-gray-300 disabled:text-gray-500 disabled:hover:bg-gray-300 dark:focus-visible:ring-offset-gray-900 dark:disabled:bg-white/10 dark:disabled:text-gray-500"
        >
          <span data-quiz-cta-label>Quiz me</span>
          <span data-quiz-cta-arrow aria-hidden="true">→</span>
        </button>
      </div>
      {/* Lock notice, shown by the island when the quiz is cooling down. */}
      <p data-quiz-lock-hint class="basis-full text-xs text-gray-500 dark:text-gray-400" hidden></p>
    </div>
  )}

  {/*
    Progress control (option B2), placed at the END of the reading flow — the
    natural "you've finished, mark it done" moment, after the body and before
    the backlinks / prev-next navigation. A quiet divider sets it apart from the
    content. State lives in the shared progress store (keyed by this note's
    route), so the roadmap graph, modal, and meter stay in sync. Enhanced by the
    `./note-progress` island, which reflects any state saved on a previous visit.
  */}
  <div
    class="mt-10 flex flex-col items-center gap-3 border-t border-gray-200 pt-6 text-center dark:border-white/10"
    data-note-progress
    data-route={route}
    data-requires-quiz={quizPool > 0 ? 'true' : undefined}
  >
    <p
      data-note-progress-heading
      class="text-sm text-gray-500 dark:text-gray-400"
    >
      {quizPool > 0 ? 'Completion' : 'Finished this note?'}
    </p>
    <button
      type="button"
      data-note-progress-input
      aria-pressed="false"
      class="note-progress-btn inline-flex items-center gap-2.5 rounded-lg border-[1.75px] px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:border-gray-300 disabled:text-gray-400 disabled:hover:bg-transparent dark:focus-visible:ring-offset-gray-900 dark:disabled:border-white/15 dark:disabled:text-gray-500"
    >
      <span
        data-note-progress-icon
        aria-hidden="true"
        class="inline-flex h-[17px] w-[17px] items-center justify-center rounded-full border-2 border-current"
      ></span>
      <span data-note-progress-label>Mark as complete</span>
    </button>
    {/* Shown by the island only when a quiz gates completion and it is not yet
        passed. Explains why the button is disabled and points at the quiz. */}
    {quizPool > 0 && (
      <p data-note-progress-hint class="text-xs text-gray-400 dark:text-gray-500" hidden>
        Score at least {quizPassMark} of {quizCount} on the quiz above to complete this note.
      </p>
    )}
  </div>

  {/*
    Scratchpad (Phase 1). A private per-note notepad for the reader's own
    summary — writing a topic in your own words is a small act of recall. Text
    is keyed by this note's route in the shared store and autosaves; the
    `./scratchpad` island fills it on load and persists edits. Progressive
    enhancement: with no JS it is simply an empty textarea.
  */}
  <section
    class="scratchpad mt-10 border-t border-gray-200 pt-6 dark:border-white/10"
    data-scratchpad
    data-route={route}
    aria-label="Your notes for this topic"
  >
    <div class="mb-2 flex items-center justify-between">
      <label
        for="scratchpad-input"
        class="flex items-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-200"
      >
        <svg class="h-4 w-4 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" />
        </svg>
        Your notes
      </label>
      <span data-scratchpad-status class="scratchpad-status text-xs" aria-live="polite"></span>
    </div>
    <textarea
      id="scratchpad-input"
      data-scratchpad-input
      rows="3"
      placeholder="Jot your own summary, questions, or things to revisit… (saved automatically, only in this browser)"
      class="scratchpad-input w-full resize-none rounded-lg border border-gray-200 bg-gray-50/60 px-3.5 py-3 text-sm leading-relaxed text-gray-800 placeholder:text-gray-400 focus-visible:border-accent-500 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500/40 dark:border-white/10 dark:bg-white/5 dark:text-gray-100 dark:placeholder:text-gray-500"
    ></textarea>
    <p class="mt-1.5 text-xs text-gray-400 dark:text-gray-500">
      Private to you, stored in this browser, never uploaded.
    </p>
  </section>
</article>

{
  quizPool > 0 && (
    <>
      {/*
        Quiz data for the island, serialized as JSON (the same pattern the
        roadmap uses). The island reads this, builds the stepper, and drives the
        dialog below. Kept out of the dialog markup so the dialog stays a thin,
        island-populated shell.
      */}
      <script type="application/json" data-quiz set:html={JSON.stringify(quiz)} />
      <script type="application/json" data-quiz-route set:html={JSON.stringify(route)} />

      {/*
        Quiz modal. A native <dialog> (same accessible pattern as the roadmap
        modal: Esc closes, backdrop click closes, focus is trapped). The island
        fills `[data-quiz-modal]` per step. `data-quiz-dialog` carries an
        explicit themed text colour because a top-layer <dialog> does not inherit
        the page's text colour.
      */}
      <dialog data-quiz-dialog class="quiz-dialog">
        <div class="quiz-shell">
          <div data-quiz-modal class="quiz-modal" />
        </div>
      </dialog>
    </>
  )
}

<style>
  /* ============================================================
     Quiz modal (guided stepper in a native <dialog>).
     A top-layer dialog does NOT inherit the page's themed text colour, so
     colour is set explicitly on the dialog and modal. Light + dark both styled.
     ============================================================ */
  .quiz-dialog {
    margin: 0;
    padding: 0;
    border: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    background: transparent;
    color: var(--gray-900);
  }
  :global([data-theme='dark']) .quiz-dialog {
    color: var(--gray-100);
  }
  .quiz-dialog::backdrop {
    background: rgba(30, 27, 46, 0.45);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  :global([data-theme='dark']) .quiz-dialog::backdrop {
    background: rgba(4, 5, 12, 0.72);
  }
  .quiz-shell {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(10px, 3vw, 40px);
  }
  .quiz-modal {
    width: min(760px, 100%);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: var(--gray-900);
    border: 1px solid var(--gray-200);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
  }
  :global([data-theme='dark']) .quiz-modal {
    background: var(--gray-900);
    color: var(--gray-100);
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* "Mark as complete" control. Colour comes from the shared `--success-*`
     semantic tokens so the "done" green follows the active palette in both
     themes (matching callouts, the copy-success state, and the roadmap modal),
     instead of an off-palette fixed emerald. Base is a ghost outline; the
     island adds `.is-done` to flip it to a solid themed fill with a tick. */
  .note-progress-btn {
    border-color: var(--success-light);
    color: var(--success-light);
    --tw-ring-color: var(--success-light);
  }
  .note-progress-btn:not(.is-done):not(:disabled):hover {
    background-color: color-mix(in srgb, var(--success-light) 10%, transparent);
  }
  .note-progress-btn.is-done {
    /* Deepened a touch so WHITE text clears WCAG AA (~5:1) on the fill. */
    background-color: color-mix(in srgb, var(--success-light) 78%, black);
    border-color: color-mix(in srgb, var(--success-light) 78%, black);
    color: #ffffff;
  }
  .note-progress-btn.is-done:hover {
    background-color: color-mix(in srgb, var(--success-light) 68%, black);
    border-color: color-mix(in srgb, var(--success-light) 68%, black);
  }
  :global([data-theme='dark']) .note-progress-btn {
    border-color: var(--success-dark);
    color: var(--success-dark);
    --tw-ring-color: var(--success-dark);
  }
  :global([data-theme='dark']) .note-progress-btn:not(.is-done):not(:disabled):hover {
    background-color: color-mix(in srgb, var(--success-dark) 15%, transparent);
  }
  :global([data-theme='dark']) .note-progress-btn.is-done {
    /* Deeper green fill so WHITE label text reads legibly in dark mode (clears
       WCAG AA), matching the roadmap modal's done button and other controls. */
    background-color: color-mix(in srgb, var(--success-dark) 50%, black);
    border-color: color-mix(in srgb, var(--success-dark) 50%, black);
    color: #ffffff;
  }
  :global([data-theme='dark']) .note-progress-btn.is-done:hover {
    background-color: color-mix(in srgb, var(--success-dark) 42%, black);
    border-color: color-mix(in srgb, var(--success-dark) 42%, black);
  }

  /* Scratchpad save-status label: subtle, and only the "Saved" tick carries the
     success colour. Hidden visually when idle (no text), announced via aria. */
  .scratchpad-status {
    color: var(--success-light);
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .scratchpad-status[data-state='saving'] {
    color: var(--gray-400, #9ca3af);
    opacity: 1;
  }
  .scratchpad-status[data-state='saved'] {
    opacity: 1;
  }
  :global([data-theme='dark']) .scratchpad-status {
    color: var(--success-dark);
  }
  :global([data-theme='dark']) .scratchpad-status[data-state='saving'] {
    color: var(--gray-500, #6b7280);
  }

  /* Flashcards: the "try to recall first" hint shown before a card is flipped.
     Reuses the quiz modal's body typography; just a muted, italic cue. */
  .fc-hint {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--gray-500, #6b7280);
  }
  :global([data-theme='dark']) .fc-hint {
    color: var(--gray-400, #9ca3af);
  }
</style>

<script>
  import './image-fallback';
  import './code-block';
  import './image-zoom';
  import './search-highlight';
  import './note-progress';
  import './quiz';
  import './scratchpad';
</script>
