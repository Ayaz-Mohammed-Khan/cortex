---
/**
 * Rendered Note content region (task 17.3; Req 3.1, 3.8, 6.1).
 *
 * Wraps the sanitized Markdown output (the `Content` component produced by
 * Astro's `render()`, already run through the KaTeX/Shiki/sanitize pipeline)
 * in the search-indexed body region. The region is marked `data-pagefind-body`
 * so Pagefind indexes it, and carries the Display_Name (as the page `h1`) and
 * the Category path as Pagefind meta + searchable text (Req 6.1, 6.7). The
 * `./image-fallback` island supplies alt/placeholder fallback for broken
 * images (Req 3.8). The `./code-block` and `./image-zoom` islands add the
 * Tier-2 reading polish (code copy button + language label; image captions +
 * click-to-zoom lightbox) as progressive, client-side enhancements.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';
import type { Quiz } from '@/lib/quiz';

/** One resolved prerequisite: its label and (if it maps to a note) its route. */
export interface PrereqLink {
  label: string;
  href: string | null;
}
type Difficulty = 'beginner' | 'intermediate' | 'advanced';

interface Props {
  /** The Note Display_Name, rendered as the page title heading. */
  displayName: string;
  /** Human-readable Category path, e.g. "AI-ML / SelfNotes". */
  categoryPath: string;
  /** The rendered Markdown component from `render(entry)`. */
  Content: AstroComponentFactory;
  /** This note's route, e.g. `/notes/.../classes-objects`. Keys the progress
   *  store so the "Mark as complete" control stays in sync with the roadmap. */
  route: string;
  /** Optional material difficulty (frontmatter), shown as a badge. */
  difficulty?: Difficulty;
  /** Optional prerequisites (frontmatter), resolved to links where possible. */
  prerequisites?: PrereqLink[];
  /** This note's quiz, when one exists; drives the "Test yourself" banner. */
  quiz?: Quiz | null;
}

const {
  displayName,
  categoryPath,
  Content,
  route,
  difficulty,
  prerequisites = [],
  quiz = null,
} = Astro.props;

// Count of questions, used in the banner copy. Zero means no banner is shown.
const quizCount = quiz?.questions.length ?? 0;
// A rough reading time: about 40 seconds per question, rounded to a minute.
const quizMinutes = quizCount > 0 ? Math.max(1, Math.round((quizCount * 40) / 60)) : 0;
// Pass threshold: the quiz counts as passed at two thirds correct, so this is
// the number of questions a reader must get right. Kept in sync with
// PASS_RATIO in `src/components/quiz.ts`.
const quizPassMark = quizCount > 0 ? Math.ceil((quizCount * 2) / 3) : 0;

// Difficulty badge palette: a distinct axis from the roadmap's core/advanced
// tier, so it uses its own green -> blue -> pink scale.
const DIFFICULTY: Record<Difficulty, { label: string; dot: string; pill: string }> = {
  beginner: {
    label: 'Beginner',
    dot: 'bg-emerald-500',
    pill: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300',
  },
  intermediate: {
    label: 'Intermediate',
    dot: 'bg-blue-500',
    pill: 'bg-blue-100 text-blue-700 dark:bg-blue-500/15 dark:text-blue-300',
  },
  advanced: {
    label: 'Advanced',
    dot: 'bg-pink-500',
    pill: 'bg-pink-100 text-pink-700 dark:bg-pink-500/15 dark:text-pink-300',
  },
};
const diff = difficulty ? DIFFICULTY[difficulty] : null;
---

<article data-pagefind-body class="min-w-0">
  <h1 data-pagefind-meta="displayName" class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
    {displayName}
  </h1>

  {/* Meta line: category, difficulty badge, then prerequisites (option 4A). */}
  {
    (categoryPath || diff) && (
      <div class="mt-2 flex flex-wrap items-center gap-2">
        {categoryPath && (
          <span class="text-sm text-gray-500 dark:text-gray-400" data-pagefind-meta="categoryPath">
            {categoryPath}
          </span>
        )}
        {diff && (
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold',
              diff.pill,
            ]}
          >
            <span class:list={['h-1.5 w-1.5 rounded-full', diff.dot]} aria-hidden="true" />
            {diff.label}
          </span>
        )}
      </div>
    )
  }

  {
    prerequisites.length > 0 && (
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Prerequisites:</span>{' '}
        {prerequisites.map((p, i) => (
          <>
            {i > 0 && ', '}
            {p.href ? (
              <a
                href={p.href}
                class="text-accent-700 underline decoration-accent-300 underline-offset-2 hover:text-accent-800 dark:text-accent-300 dark:decoration-accent-500 dark:hover:text-accent-200"
              >
                {p.label}
              </a>
            ) : (
              <span
                title={`${p.label} - coming soon`}
                class="text-gray-400 underline decoration-dashed decoration-gray-300 underline-offset-2 dark:text-gray-500 dark:decoration-gray-600"
              >
                {p.label}
                <span class="text-xs text-gray-400 dark:text-gray-500"> (soon)</span>
              </span>
            )}
          </>
        ))}
      </p>
    )
  }

  <div class="note-body mt-6">
    <Content />
  </div>

  {/*
    Quiz entry banner. Shown only when this note has a companion quiz. It is a
    quiet call-to-action (a container with an explicit Start button, not a
    whole-card click target), sitting after the body and before "Mark as
    complete" so the flow reads: read the note, test yourself, mark it done. The
    `./quiz` island reads the serialized quiz below and opens the modal.
  */}
  {quizCount > 0 && (
    <div
      class="mt-10 flex items-center gap-4 rounded-2xl border border-accent-200 bg-accent-50/60 px-5 py-4 dark:border-accent-500/25 dark:bg-accent-500/10"
      data-quiz-banner
    >
      <span
        aria-hidden="true"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-accent-100 text-accent-600 dark:bg-accent-500/20 dark:text-accent-300"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 11l3 3L22 4" />
          <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
        </svg>
      </span>
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-gray-900 dark:text-gray-100">Test yourself</p>
        <p class="text-sm text-gray-600 dark:text-gray-400">
          {quizCount} {quizCount === 1 ? 'question' : 'questions'}, about {quizMinutes} {quizMinutes === 1 ? 'minute' : 'minutes'}. Score {quizPassMark} or more to complete this note.
        </p>
      </div>
      <button
        type="button"
        data-quiz-start
        class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-accent-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-accent-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
      >
        Start
        <span aria-hidden="true">→</span>
      </button>
    </div>
  )}

  {/*
    Progress control (option B2), placed at the END of the reading flow — the
    natural "you've finished, mark it done" moment, after the body and before
    the backlinks / prev-next navigation. A quiet divider sets it apart from the
    content. State lives in the shared progress store (keyed by this note's
    route), so the roadmap graph, modal, and meter stay in sync. Enhanced by the
    `./note-progress` island, which reflects any state saved on a previous visit.
  */}
  <div
    class="mt-10 flex flex-col items-center gap-3 border-t border-gray-200 pt-6 text-center dark:border-white/10"
    data-note-progress
    data-route={route}
    data-requires-quiz={quizCount > 0 ? 'true' : undefined}
  >
    <p
      data-note-progress-heading
      class="text-sm text-gray-500 dark:text-gray-400"
    >
      {quizCount > 0 ? 'Completion' : 'Finished this note?'}
    </p>
    <button
      type="button"
      data-note-progress-input
      aria-pressed="false"
      class="note-progress-btn inline-flex items-center gap-2.5 rounded-lg border-[1.75px] px-4 py-2 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:border-gray-300 disabled:text-gray-400 disabled:hover:bg-transparent dark:focus-visible:ring-offset-gray-900 dark:disabled:border-white/15 dark:disabled:text-gray-500"
    >
      <span
        data-note-progress-icon
        aria-hidden="true"
        class="inline-flex h-[17px] w-[17px] items-center justify-center rounded-full border-2 border-current"
      ></span>
      <span data-note-progress-label>Mark as complete</span>
    </button>
    {/* Shown by the island only when a quiz gates completion and it is not yet
        passed. Explains why the button is disabled and points at the quiz. */}
    {quizCount > 0 && (
      <p data-note-progress-hint class="text-xs text-gray-400 dark:text-gray-500" hidden>
        Score at least {quizPassMark} of {quizCount} on the quiz above to complete this note.
      </p>
    )}
  </div>
</article>

{
  quizCount > 0 && (
    <>
      {/*
        Quiz data for the island, serialized as JSON (the same pattern the
        roadmap uses). The island reads this, builds the stepper, and drives the
        dialog below. Kept out of the dialog markup so the dialog stays a thin,
        island-populated shell.
      */}
      <script type="application/json" data-quiz set:html={JSON.stringify(quiz)} />
      <script type="application/json" data-quiz-route set:html={JSON.stringify(route)} />

      {/*
        Quiz modal. A native <dialog> (same accessible pattern as the roadmap
        modal: Esc closes, backdrop click closes, focus is trapped). The island
        fills `[data-quiz-modal]` per step. `data-quiz-dialog` carries an
        explicit themed text colour because a top-layer <dialog> does not inherit
        the page's text colour.
      */}
      <dialog data-quiz-dialog class="quiz-dialog">
        <div class="quiz-shell">
          <div data-quiz-modal class="quiz-modal" />
        </div>
      </dialog>
    </>
  )
}

<style>
  /* ============================================================
     Quiz modal (guided stepper in a native <dialog>).
     A top-layer dialog does NOT inherit the page's themed text colour, so
     colour is set explicitly on the dialog and modal. Light + dark both styled.
     ============================================================ */
  .quiz-dialog {
    margin: 0;
    padding: 0;
    border: 0;
    max-width: none;
    max-height: none;
    width: 100%;
    height: 100%;
    background: transparent;
    color: var(--gray-900);
  }
  :global([data-theme='dark']) .quiz-dialog {
    color: var(--gray-100);
  }
  .quiz-dialog::backdrop {
    background: rgba(30, 27, 46, 0.45);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
  }
  :global([data-theme='dark']) .quiz-dialog::backdrop {
    background: rgba(4, 5, 12, 0.72);
  }
  .quiz-shell {
    position: fixed;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(10px, 3vw, 40px);
  }
  .quiz-modal {
    width: min(760px, 100%);
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    background: #ffffff;
    color: var(--gray-900);
    border: 1px solid var(--gray-200);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.3);
  }
  :global([data-theme='dark']) .quiz-modal {
    background: var(--gray-900);
    color: var(--gray-100);
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* "Mark as complete" control. Colour comes from the shared `--success-*`
     semantic tokens so the "done" green follows the active palette in both
     themes (matching callouts, the copy-success state, and the roadmap modal),
     instead of an off-palette fixed emerald. Base is a ghost outline; the
     island adds `.is-done` to flip it to a solid themed fill with a tick. */
  .note-progress-btn {
    border-color: var(--success-light);
    color: var(--success-light);
    --tw-ring-color: var(--success-light);
  }
  .note-progress-btn:not(.is-done):not(:disabled):hover {
    background-color: color-mix(in srgb, var(--success-light) 10%, transparent);
  }
  .note-progress-btn.is-done {
    background-color: var(--success-light);
    border-color: var(--success-light);
    color: #ffffff;
  }
  .note-progress-btn.is-done:hover {
    background-color: color-mix(in srgb, var(--success-light) 85%, black);
    border-color: color-mix(in srgb, var(--success-light) 85%, black);
  }
  :global([data-theme='dark']) .note-progress-btn {
    border-color: var(--success-dark);
    color: var(--success-dark);
    --tw-ring-color: var(--success-dark);
  }
  :global([data-theme='dark']) .note-progress-btn:not(.is-done):not(:disabled):hover {
    background-color: color-mix(in srgb, var(--success-dark) 15%, transparent);
  }
  :global([data-theme='dark']) .note-progress-btn.is-done {
    background-color: var(--success-dark);
    border-color: var(--success-dark);
    color: #042f1f;
  }
  :global([data-theme='dark']) .note-progress-btn.is-done:hover {
    background-color: color-mix(in srgb, var(--success-dark) 85%, white);
    border-color: color-mix(in srgb, var(--success-dark) 85%, white);
  }
</style>

<script>
  import './image-fallback';
  import './code-block';
  import './image-zoom';
  import './search-highlight';
  import './note-progress';
  import './quiz';
</script>
