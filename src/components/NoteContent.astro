---
/**
 * Rendered Note content region (task 17.3; Req 3.1, 3.8, 6.1).
 *
 * Wraps the sanitized Markdown output (the `Content` component produced by
 * Astro's `render()`, already run through the KaTeX/Shiki/sanitize pipeline)
 * in the search-indexed body region. The region is marked `data-pagefind-body`
 * so Pagefind indexes it, and carries the Display_Name (as the page `h1`) and
 * the Category path as Pagefind meta + searchable text (Req 6.1, 6.7). The
 * `./image-fallback` island supplies alt/placeholder fallback for broken
 * images (Req 3.8). The `./code-block` and `./image-zoom` islands add the
 * Tier-2 reading polish (code copy button + language label; image captions +
 * click-to-zoom lightbox) as progressive, client-side enhancements.
 */
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

/** One resolved prerequisite: its label and (if it maps to a note) its route. */
export interface PrereqLink {
  label: string;
  href: string | null;
}
type Difficulty = 'beginner' | 'intermediate' | 'advanced';

interface Props {
  /** The Note Display_Name, rendered as the page title heading. */
  displayName: string;
  /** Human-readable Category path, e.g. "AI-ML / SelfNotes". */
  categoryPath: string;
  /** The rendered Markdown component from `render(entry)`. */
  Content: AstroComponentFactory;
  /** Optional material difficulty (frontmatter), shown as a badge. */
  difficulty?: Difficulty;
  /** Optional prerequisites (frontmatter), resolved to links where possible. */
  prerequisites?: PrereqLink[];
}

const { displayName, categoryPath, Content, difficulty, prerequisites = [] } = Astro.props;

// Difficulty badge palette: a distinct axis from the roadmap's core/advanced
// tier, so it uses its own green -> blue -> pink scale.
const DIFFICULTY: Record<Difficulty, { label: string; dot: string; pill: string }> = {
  beginner: {
    label: 'Beginner',
    dot: 'bg-emerald-500',
    pill: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300',
  },
  intermediate: {
    label: 'Intermediate',
    dot: 'bg-blue-500',
    pill: 'bg-blue-100 text-blue-700 dark:bg-blue-500/15 dark:text-blue-300',
  },
  advanced: {
    label: 'Advanced',
    dot: 'bg-pink-500',
    pill: 'bg-pink-100 text-pink-700 dark:bg-pink-500/15 dark:text-pink-300',
  },
};
const diff = difficulty ? DIFFICULTY[difficulty] : null;
---

<article data-pagefind-body class="min-w-0">
  <h1 data-pagefind-meta="displayName" class="text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
    {displayName}
  </h1>

  {/* Meta line: category, difficulty badge, then prerequisites (option 4A). */}
  {
    (categoryPath || diff) && (
      <div class="mt-2 flex flex-wrap items-center gap-2">
        {categoryPath && (
          <span class="text-sm text-gray-500 dark:text-gray-400" data-pagefind-meta="categoryPath">
            {categoryPath}
          </span>
        )}
        {diff && (
          <span
            class:list={[
              'inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold',
              diff.pill,
            ]}
          >
            <span class:list={['h-1.5 w-1.5 rounded-full', diff.dot]} aria-hidden="true" />
            {diff.label}
          </span>
        )}
      </div>
    )
  }

  {
    prerequisites.length > 0 && (
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
        <span class="font-semibold text-gray-700 dark:text-gray-300">Prerequisites:</span>{' '}
        {prerequisites.map((p, i) => (
          <>
            {i > 0 && ', '}
            {p.href ? (
              <a
                href={p.href}
                class="text-violet-700 underline decoration-violet-300 underline-offset-2 hover:text-violet-800 dark:text-violet-300 dark:decoration-violet-500 dark:hover:text-violet-200"
              >
                {p.label}
              </a>
            ) : (
              <span>{p.label}</span>
            )}
          </>
        ))}
      </p>
    )
  }

  <div class="note-body mt-6">
    <Content />
  </div>
</article>

<script>
  import './image-fallback';
  import './code-block';
  import './image-zoom';
  import './search-highlight';
</script>
