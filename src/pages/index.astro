{/*
  Scroll-reveal: add `.is-in` to each `.lp-reveal` as it enters the viewport, so
  sections rise + fade in once. Progressive enhancement — with no JS (or reduced
  motion) the CSS shows everything immediately. One shared observer, cheap.
*/}
<script>
  function armReveal(): void {
    const els = Array.from(document.querySelectorAll<HTMLElement>('.lp-reveal'));
    if (els.length === 0) return;
    const reduce = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ?? false;
    if (reduce || !('IntersectionObserver' in window)) {
      for (const el of els) el.classList.add('is-in');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
    );
    for (const el of els) io.observe(el);
  }
  // Run on first load and after every View Transition swap.
  document.addEventListener('astro:page-load', armReveal);
</script>

<style>
  /* ===== Scroll reveal ===== */
  .lp-reveal {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.6s ease, transform 0.6s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: var(--d, 0s);
  }
  .lp-reveal.is-in {
    opacity: 1;
    transform: none;
  }

  /* ===== Mock cards ===== */
  .lp-card {
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .lp-card :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (hover: hover) {
    .lp-feature-art:hover .lp-card,
    .lp-hero-art:hover .lp-card {
      transform: translateY(-4px);
      box-shadow: 0 24px 50px -12px rgba(0, 0, 0, 0.25);
    }
  }

  /* ===== Hero accent + CTA arrow ===== */
  .lp-ping span:first-child {
    animation: lp-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes lp-ping {
    75%, 100% { transform: scale(2.4); opacity: 0; }
  }
  .lp-cta-btn .lp-arrow {
    transition: transform 0.2s ease;
  }
  .lp-cta-btn:hover .lp-arrow {
    transform: translateX(3px);
  }
  .lp-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at top, color-mix(in srgb, var(--accent-500) 12%, transparent), transparent 60%);
    pointer-events: none;
  }

  /* ===========================================================
     In-mock animations. Each only runs once its card has scrolled
     in (`.is-in` on the enclosing `.lp-reveal`), so the motion lands
     with attention on it, and never runs under reduced motion.
     =========================================================== */

  /* Hero: nodes pop in, the quiz card lifts, its timer + option settle. */
  .lp-hero-node { opacity: 0; transform: scale(0.4); transform-origin: center; transform-box: fill-box; }
  .is-in .lp-hero-node { animation: lp-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; animation-delay: var(--d); }
  .lp-hero-card { opacity: 0; transform: translateY(16px); transform-box: fill-box; }
  .is-in .lp-hero-card { animation: lp-rise 0.6s ease forwards 0.5s; }
  .lp-hero-timer { transform-box: fill-box; transform-origin: center; }
  .is-in .lp-hero-timer { animation: lp-pulse 1.6s ease-in-out infinite 1.1s; }
  .lp-hero-opt { opacity: 0; transform-box: fill-box; }
  .is-in .lp-hero-opt { animation: lp-fade 0.4s ease forwards 0.9s; }
  .lp-signal { opacity: 0; }
  .is-in .lp-signal { opacity: 1; }

  @keyframes lp-pop { to { opacity: 1; transform: scale(1); } }
  @keyframes lp-rise { to { opacity: 1; transform: none; } }
  @keyframes lp-fade { to { opacity: 1; } }
  @keyframes lp-pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }

  /* Roadmap mock: bands slide in, chips pop. */
  .lp-band { opacity: 0; transform: translateX(-14px); transform-box: fill-box; }
  .is-in .lp-band { animation: lp-slide-x 0.5s ease forwards; animation-delay: var(--d); }
  .lp-chip { opacity: 0; transform: scale(0.6); transform-box: fill-box; transform-origin: center; }
  .is-in .lp-chip { animation: lp-pop 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; animation-delay: calc(0.2s + var(--d)); }
  @keyframes lp-slide-x { to { opacity: 1; transform: none; } }

  /* Notes mock: wikilink glows, backlinks slide in, TOC active bar grows. */
  .lp-wikilink { transform-box: fill-box; }
  .is-in .lp-wikilink rect:first-child { animation: lp-glow 2.4s ease-in-out infinite 0.6s; }
  @keyframes lp-glow { 0%, 100% { opacity: 0.6; } 50% { opacity: 1; } }
  .lp-backlink { opacity: 0; transform: translateX(-10px); transform-box: fill-box; }
  .is-in .lp-backlink { animation: lp-slide-x 0.45s ease forwards; animation-delay: var(--d); }
  .lp-toc-active { transform-box: fill-box; transform-origin: left center; }
  .is-in .lp-toc-active { animation: lp-fade 0.5s ease forwards 0.3s; opacity: 0; }

  /* Quiz mock: progress bar fills, timer pulses urgent, picked option pops. */
  .lp-progress { transform-box: fill-box; transform-origin: left center; transform: scaleX(0); }
