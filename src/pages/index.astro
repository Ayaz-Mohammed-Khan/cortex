  return `<svg ${VB} role="img" aria-label="A note with an inline wikilink and a backlinks panel">
    ${surface()}
    ${winHeader('Strings')}
    <!-- body -->
    <rect x="26" y="72" width="150" height="7" rx="3.5" fill="var(--accent-500, #8b5cf6)"/>
    ${line(26, 94, 290)}
    ${line(26, 112, 268)}
    <!-- inline wikilink: pill, animates a subtle glow -->
    <g class="lp-wikilink">
      <rect x="150" y="128" width="92" height="13" rx="4" fill="var(--accent-100, #ede9fe)"/>
      ${line(26, 130, 118)}
      ${line(156, 131, 80, 'var(--accent-600, #7c3aed)')}
      ${line(250, 130, 66)}
    </g>
    ${line(26, 150, 300)}
    <!-- callout -->
    <rect x="26" y="172" width="300" height="44" rx="8" fill="var(--accent-50, #f5f3ff)" stroke="var(--accent-200, #ddd6fe)" stroke-width="1.5"/>
    <rect x="26" y="172" width="4" height="44" rx="2" fill="var(--accent-500, #8b5cf6)"/>
    ${line(42, 185, 110, 'var(--accent-400, #a78bfa)')}
    ${line(42, 201, 250)}
    <!-- backlinks panel: links slide in -->
    <rect x="26" y="232" width="300" height="60" rx="8" fill="var(--gray-100, #f3f4f6)"/>
    ${line(40, 246, 96, 'var(--gray-500, #6b7280)')}
    <g class="lp-backlink" style="--d:0.1s">${line(40, 264, 150, 'var(--accent-500, #8b5cf6)')}</g>
    <g class="lp-backlink" style="--d:0.25s">${line(40, 278, 120, 'var(--accent-500, #8b5cf6)')}</g>
    <g class="lp-backlink" style="--d:0.4s">${line(206, 264, 108, 'var(--accent-500, #8b5cf6)')}</g>
    <!-- TOC rail with an active item -->
    <rect x="350" y="72" width="86" height="220" rx="10" fill="var(--gray-100, #f3f4f6)"/>
    ${line(366, 92, 60)}
    <g class="lp-toc-active"><rect x="360" y="106" width="4" height="10" rx="2" fill="var(--accent-500, #8b5cf6)"/>${line(372, 108, 54, 'var(--accent-500, #8b5cf6)')}</g>
    ${line(366, 128, 48)}
    ${line(366, 148, 56)}
    ${line(366, 168, 44)}
  </svg>`;
}

/** QUIZ: the real modal — timer pill (pulses low), progress bar, letter options. */
function quizMock(): string {
  const timer =
    `<g class="lp-timer"><rect x="356" y="14" width="58" height="24" rx="12" fill="var(--accent-500, #8b5cf6)"/>` +
    `<text x="385" y="30" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12.5" font-weight="700" fill="#fff" font-variant-numeric="tabular-nums">1:12</text></g>`;
  const option = (y: number, letter: string, w: number, state: 'idle' | 'picked'): string => {
    const picked = state === 'picked';
    return (
      `<g class="${picked ? 'lp-opt-picked' : 'lp-opt'}">` +
      `<rect x="40" y="${y}" width="380" height="36" rx="9" fill="${picked ? 'var(--accent-50, #f5f3ff)' : '#fff'}" stroke="${picked ? 'var(--accent-500, #8b5cf6)' : 'var(--gray-200, #e5e7eb)'}" stroke-width="1.5"/>` +
      `<circle cx="60" cy="${y + 18}" r="10" fill="${picked ? 'var(--accent-600, #7c3aed)' : 'none'}" stroke="${picked ? 'var(--accent-600, #7c3aed)' : 'var(--gray-400, #9ca3af)'}" stroke-width="2"/>` +
      `<text x="60" y="${y + 22}" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10.5" font-weight="700" fill="${picked ? '#fff' : 'var(--gray-500, #6b7280)'}">${letter}</text>` +
      `<rect x="80" y="${y + 13}" width="${w}" height="9" rx="4.5" fill="var(--gray-400, #9ca3af)"/>` +
      `</g>`
    );
  };
  return `<svg ${VB} role="img" aria-label="A timed quiz with four options and a countdown">
    ${surface()}
    ${winHeader('Test yourself', timer)}
    <!-- progress bar (fills on reveal) + pills -->
    <rect x="40" y="66" width="300" height="6" rx="3" fill="var(--gray-200, #e5e7eb)"/>
    <rect class="lp-progress" x="40" y="66" width="300" height="6" rx="3" fill="var(--accent-500, #8b5cf6)"/>
    <g fill="var(--accent-500, #8b5cf6)">
      <circle cx="356" cy="69" r="3.5"/><circle cx="368" cy="69" r="3.5"/>
      <circle cx="380" cy="69" r="3.5" fill="var(--gray-300, #d1d5db)"/><circle cx="392" cy="69" r="3.5" fill="var(--gray-300, #d1d5db)"/>
      <circle cx="404" cy="69" r="3.5" fill="var(--gray-300, #d1d5db)"/>
    </g>
    <!-- question stem -->
    <rect x="40" y="88" width="320" height="10" rx="5" fill="var(--gray-700, #374151)"/>
    <rect x="40" y="106" width="230" height="10" rx="5" fill="var(--gray-700, #374151)"/>
    <!-- options; B is briefly picked -->
    ${option(132, 'A', 300, 'idle')}
    ${option(176, 'B', 250, 'picked')}
    ${option(220, 'C', 290, 'idle')}
    ${option(264, 'D', 230, 'idle')}
  </svg>`;
}

/** REVIEW: the real "review due" card — clock icon, count, chips, start button. */
