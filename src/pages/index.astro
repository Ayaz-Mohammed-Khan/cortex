    <defs><linearGradient id="lp-meter-grad" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" stop-color="var(--accent-600, #7c3aed)"/><stop offset="1" stop-color="var(--success-light, #16a34a)"/>
    </linearGradient></defs>
    <!-- a row of completed ticks + two pending -->
    ${tick(50, 0)}${tick(100, 1)}${tick(150, 2)}
