    `<rect x="56" y="${y + 13}" width="${w}" height="9" rx="4.5" fill="var(--gray-700, #374151)"/>` +
    `<rect x="56" y="${y + 30}" width="${w + 44}" height="7" rx="3.5" fill="var(--gray-400, #9ca3af)"/>` +
    `<rect x="318" y="${y + 11}" width="86" height="28" rx="8" fill="var(--accent-600, #7c3aed)"/>` +
    `<text x="361" y="${y + 29}" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#fff">${label}</text></g>`;
  return `<svg ${VB} role="img" aria-label="A cumulative-recall card with weekly and monthly sessions">
