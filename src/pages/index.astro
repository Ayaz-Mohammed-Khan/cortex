---
/**
 * Landing page (site root `/`): the marketing / feature showcase.
 *
 * The front door. It sells Cortex by SHOWING it: every feature is paired with a
 * hand-authored SVG mock that reproduces the REAL interface (same palette
 * tokens, same card shapes, same letter markers / score ring / timer pill as
 * the live components), and the mocks ANIMATE on view so the page feels like
 * the product in motion rather than a flat brochure. CTAs lead into the
 * interactive roadmap (`/roadmap`) and the notes.
 *
 * Why SVG mocks over screenshots: they are tiny, static, theme through the same
 * CSS custom properties as the live UI, carry no personal state, and never go
 * stale against the build. All animation is CSS-driven and gated behind
 * `prefers-reduced-motion`, so there is no client JS beyond a tiny scroll-reveal
 * observer that also no-ops under reduced motion.
 *
 * Uses the shared Layout with `chrome="landing"` (no note tree, controls in the
 * header). `prerender = true`; the only data it needs is a few real counts.
 */
import Layout from '@/components/Layout.astro';
import SeoHead from '@/components/SeoHead.astro';
import { loadSite } from '@/lib/content';
import { spine, phases } from '@/data/roadmap';

export const prerender = true;

const site = await loadSite();
const siteBase = Astro.site?.href;

