---
/**
 * Landing page (site root `/`): the marketing / feature showcase.
 *
 * This is the front door. It introduces Cortex and shows what the site does
 * through hand-authored SVG mocks that echo the REAL interface (same palette
 * tokens, same card shapes), then sends the reader into the interactive
 * `/roadmap` or straight to the notes. The roadmap graph itself now lives at
 * `/roadmap` (`src/pages/roadmap.astro`); this page links to it.
 *
 * Why SVG mocks rather than screenshots: screenshots go stale, carry a reader's
 * personal state, and do not theme. These inline SVGs are static, tiny, theme
 * through the same CSS custom properties as the live UI, and never drift from
 * the build. They are illustrative, not pixel-perfect captures.
 *
 * Uses the shared Layout with `chrome="landing"` (no note tree, controls in the
 * header). `prerender = true`; the only data it needs is a few real counts.
 */
import Layout from '@/components/Layout.astro';
import SeoHead from '@/components/SeoHead.astro';
import { loadSite } from '@/lib/content';
import { spine, phases } from '@/data/roadmap';

export const prerender = true;

const site = await loadSite();
const siteBase = Astro.site?.href;

// Real headline numbers, derived from the syllabus data and the content model
// so the copy never drifts from what actually ships.
const trackCount = spine.length;
const phaseCount = phases.length;
// How many published notes actually exist to read (computed once by the content
// loader; see `publishedNoteRoutes` in `src/lib/content.ts`).
const noteCount = site.publishedNoteRoutes.length;

/** A feature shown in the showcase grid: copy on one side, SVG mock the other. */
interface Feature {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
}

// The feature list drives the showcase sections; each `id` maps to an inline
// SVG mock rendered below (a small switch keeps the markup readable).
const features: Feature[] = [
  {
    id: 'roadmap',
    eyebrow: 'Start here',
    title: 'A roadmap, not a reading list',
    body: 'The whole data-science journey as one branching map, from Python foundations to deployment. Switch between a simple phase overview and a detailed topic graph, and click any node to see exactly what to learn.',
  },
  {
    id: 'notes',
    eyebrow: 'The source of truth',
    title: 'Notes that link themselves',
    body: 'Every topic is a focused note with math, callouts, and diagrams. Wikilinks connect related ideas and backlinks appear automatically, so the material reads as a connected web rather than isolated pages.',
  },
  {
    id: 'quiz',
    eyebrow: 'Prove it',
    title: 'Timed quizzes that test judgement',
    body: 'Each note carries a bank of questions. A graded attempt samples a fresh, timed subset every sitting, so you cannot pass by memorising an order. Clear two-thirds to mark the topic complete.',
  },
  {
    id: 'review',
    eyebrow: 'Keep it',
    title: 'Spaced repetition, built in',
    body: 'Pass a quiz and the topic enters a review schedule that stretches out as you keep getting it right and snaps back when you slip. The home for a quick daily pass that stops what you learned from fading.',
  },
  {
    id: 'recall',
    eyebrow: 'Connect it',
    title: 'Weekly and monthly recall',
    body: 'At the end of a study window, recall across everything you covered at once, not one note at a time. Fall behind and the prompt escalates, so the habit holds instead of quietly lapsing.',
  },
  {
    id: 'progress',
    eyebrow: 'See it',
    title: 'Progress you own',
    body: 'Completions, streaks, review schedule, and recall history live in your browser, with no account to create. Back it all up to a file and restore it on any device, any time.',
  },
];

/* ---------------------------------------------------------------------------
 * SVG mocks of the real UI.
 *
 * These are plain SVG strings injected with `set:html`. They are illustrative,
 * not screenshots: each uses the palette TOKENS (`var(--accent-*)` etc.) so it
 * themes with the page, and mirrors the shape of the live surface it previews.
 * All text is baked in (not interactive) so there is no client cost.
 *
 * A shared 440x300 viewBox keeps every card the same aspect ratio. Colours come
 * from CSS custom properties, which inline SVG honours for fill/stroke, so a
 * single mock looks right in both light and dark themes.
 * --------------------------------------------------------------------------- */

const VB = 'viewBox="0 0 440 300" role="img" preserveAspectRatio="xMidYMid meet"';

/** A rounded panel background filling the mock, matching a card surface. */
function panel(): string {
  return `<rect x="0" y="0" width="440" height="300" rx="14" fill="var(--gray-50, #f9fafb)"/>`;
}

/** The hero mock: the roadmap spine with nodes and a floating quiz chip. */
function heroMock(): string {
  const node = (x: number, y: number, done: boolean): string =>
    `<circle cx="${x}" cy="${y}" r="13" fill="${done ? 'var(--success-light, #16a34a)' : 'var(--accent-500, #8b5cf6)'}"/>` +
    (done
      ? `<path d="M${x - 5} ${y} l3.5 3.5 L${x + 6} ${y - 5}" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`
      : `<circle cx="${x}" cy="${y}" r="4.5" fill="#fff" fill-opacity="0.85"/>`);
  return `<svg ${VB} aria-label="A branching learning roadmap with a quiz card" xmlns="http://www.w3.org/2000/svg">
    ${panel()}
    <!-- spine -->
    <path d="M70 40 V 260" stroke="var(--accent-300, #c4b5fd)" stroke-width="6" stroke-linecap="round"/>
    <!-- branches -->
    <path d="M70 70 C 130 70, 150 70, 200 70" stroke="var(--accent-200, #ddd6fe)" stroke-width="4" fill="none"/>
    <path d="M70 130 C 130 130, 150 130, 200 130" stroke="var(--accent-200, #ddd6fe)" stroke-width="4" fill="none"/>
    <path d="M70 190 C 130 190, 150 190, 200 190" stroke="var(--accent-200, #ddd6fe)" stroke-width="4" fill="none"/>
    <!-- spine nodes -->
    ${node(70, 40, true)}
    ${node(70, 100, true)}
    ${node(70, 160, false)}
    ${node(70, 220, false)}
    <!-- branch leaf nodes + labels -->
    ${node(200, 70, true)}
    ${node(200, 130, false)}
    ${node(200, 190, false)}
    <rect x="222" y="60" width="92" height="20" rx="6" fill="var(--gray-200, #e5e7eb)"/>
    <rect x="222" y="120" width="78" height="20" rx="6" fill="var(--gray-200, #e5e7eb)"/>
    <rect x="222" y="180" width="86" height="20" rx="6" fill="var(--gray-200, #e5e7eb)"/>
    <!-- floating quiz chip -->
    <g>
      <rect x="248" y="150" width="172" height="118" rx="12" fill="#fff" stroke="var(--accent-200, #ddd6fe)" stroke-width="1.5" filter="drop-shadow(0 6px 14px rgba(0,0,0,0.12))"/>
      <rect x="262" y="164" width="80" height="10" rx="5" fill="var(--accent-500, #8b5cf6)"/>
      <rect x="262" y="186" width="144" height="9" rx="4.5" fill="var(--gray-300, #d1d5db)"/>
      <rect x="262" y="202" width="120" height="9" rx="4.5" fill="var(--gray-300, #d1d5db)"/>
      <rect x="262" y="224" width="144" height="26" rx="7" fill="var(--accent-100, #ede9fe)" stroke="var(--accent-400, #a78bfa)" stroke-width="1.5"/>
      <circle cx="276" cy="237" r="6" fill="none" stroke="var(--accent-500, #8b5cf6)" stroke-width="2"/>
      <rect x="290" y="233" width="90" height="8" rx="4" fill="var(--accent-500, #8b5cf6)"/>
    </g>
  </svg>`;
}

/** The per-feature mock, keyed by feature id. */
function featureMock(id: string): string {
  switch (id) {
    case 'roadmap':
      return heroMock();
    case 'notes':
      return notesMock();
    case 'quiz':
      return quizMock();
    case 'review':
      return reviewMock();
    case 'recall':
      return recallMock();
    case 'progress':
      return progressMock();
    default:
      return `<svg ${VB} xmlns="http://www.w3.org/2000/svg">${panel()}</svg>`;
  }
}

/** A note page: heading, prose lines, a highlighted wikilink, a backlinks box. */
function notesMock(): string {
  const line = (x: number, y: number, w: number): string =>
    `<rect x="${x}" y="${y}" width="${w}" height="9" rx="4.5" fill="var(--gray-300, #d1d5db)"/>`;
  return `<svg ${VB} aria-label="A note page with a wikilink and a backlinks panel" xmlns="http://www.w3.org/2000/svg">
    ${panel()}
    <rect x="26" y="28" width="200" height="18" rx="6" fill="var(--gray-800, #1f2937)"/>
    <rect x="26" y="56" width="120" height="11" rx="5" fill="var(--accent-500, #8b5cf6)"/>
    ${line(26, 86, 300)}
    ${line(26, 104, 280)}
    <!-- inline wikilink -->
    <rect x="150" y="120" width="96" height="12" rx="4" fill="var(--accent-100, #ede9fe)"/>
    <rect x="150" y="122" width="96" height="9" rx="4.5" fill="var(--accent-600, #7c3aed)"/>
    ${line(26, 122, 118)}
    ${line(252, 122, 74)}
    ${line(26, 140, 290)}
    ${line(26, 158, 240)}
    <!-- callout block -->
    <rect x="26" y="182" width="300" height="46" rx="8" fill="var(--accent-50, #f5f3ff)" stroke="var(--accent-200, #ddd6fe)" stroke-width="1.5"/>
    <rect x="26" y="182" width="4" height="46" rx="2" fill="var(--accent-500, #8b5cf6)"/>
    ${line(42, 196, 120)}
    ${line(42, 212, 250)}
    <!-- backlinks panel -->
    <rect x="26" y="244" width="388" height="40" rx="8" fill="var(--gray-100, #f3f4f6)"/>
    <rect x="40" y="256" width="90" height="9" rx="4.5" fill="var(--gray-500, #6b7280)"/>
    <rect x="40" y="270" width="150" height="8" rx="4" fill="var(--accent-500, #8b5cf6)"/>
    <rect x="206" y="270" width="120" height="8" rx="4" fill="var(--accent-500, #8b5cf6)"/>
    <!-- right rail (toc) -->
    <rect x="348" y="86" width="66" height="7" rx="3.5" fill="var(--gray-300, #d1d5db)"/>
    <rect x="348" y="102" width="54" height="7" rx="3.5" fill="var(--accent-400, #a78bfa)"/>
    <rect x="348" y="118" width="60" height="7" rx="3.5" fill="var(--gray-300, #d1d5db)"/>
    <rect x="348" y="134" width="48" height="7" rx="3.5" fill="var(--gray-300, #d1d5db)"/>
  </svg>`;
}

/** The quiz modal: header with timer, a question stem, four options, progress. */
function quizMock(): string {
  const opt = (y: number, letter: string, w: number, picked: boolean): string =>
    `<rect x="40" y="${y}" width="360" height="34" rx="8" fill="${picked ? 'var(--accent-100, #ede9fe)' : 'var(--gray-100, #f3f4f6)'}" stroke="${picked ? 'var(--accent-400, #a78bfa)' : 'var(--gray-200, #e5e7eb)'}" stroke-width="1.5"/>` +
    `<circle cx="58" cy="${y + 17}" r="9" fill="none" stroke="${picked ? 'var(--accent-500, #8b5cf6)' : 'var(--gray-400, #9ca3af)'}" stroke-width="1.6"/>` +
    `<text x="58" y="${y + 21}" text-anchor="middle" font-family="system-ui, sans-serif" font-size="10" font-weight="700" fill="${picked ? 'var(--accent-600, #7c3aed)' : 'var(--gray-500, #6b7280)'}">${letter}</text>` +
    `<rect x="78" y="${y + 12}" width="${w}" height="9" rx="4.5" fill="var(--gray-400, #9ca3af)"/>`;
  return `<svg ${VB} aria-label="A timed quiz with four answer options" xmlns="http://www.w3.org/2000/svg">
    ${panel()}
    <!-- header -->
    <rect x="0" y="0" width="440" height="46" rx="14" fill="var(--gray-100, #f3f4f6)"/>
    <rect x="0" y="32" width="440" height="14" fill="var(--gray-100, #f3f4f6)"/>
    <rect x="20" y="14" width="26" height="20" rx="6" fill="var(--accent-100, #ede9fe)"/>
    <path d="M28 24 l3 3 l7 -7" fill="none" stroke="var(--accent-600, #7c3aed)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    <rect x="56" y="17" width="96" height="14" rx="5" fill="var(--gray-700, #374151)"/>
    <!-- timer pill -->
    <rect x="336" y="13" width="58" height="22" rx="11" fill="var(--accent-500, #8b5cf6)"/>
    <text x="365" y="28" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#fff">4:30</text>
    <!-- progress pills -->
    <rect x="20" y="60" width="300" height="6" rx="3" fill="var(--gray-200, #e5e7eb)"/>
    <rect x="20" y="60" width="120" height="6" rx="3" fill="var(--accent-500, #8b5cf6)"/>
    <!-- question stem -->
    <rect x="40" y="82" width="300" height="11" rx="5" fill="var(--gray-700, #374151)"/>
    <rect x="40" y="100" width="220" height="11" rx="5" fill="var(--gray-700, #374151)"/>
    <!-- options -->
    ${opt(126, 'A', 300, false)}
    ${opt(166, 'B', 260, true)}
    ${opt(206, 'C', 290, false)}
    ${opt(246, 'D', 240, false)}
  </svg>`;
}

/** The "Review due today" card: icon, count, topic chips, start button. */
function reviewMock(): string {
  const chip = (x: number, w: number): string =>
    `<rect x="${x}" y="210" width="${w}" height="26" rx="13" fill="var(--accent-100, #ede9fe)"/>` +
    `<rect x="${x + 14}" y="220" width="${w - 28}" height="7" rx="3.5" fill="var(--accent-600, #7c3aed)"/>`;
  return `<svg ${VB} aria-label="A spaced-repetition review-due card" xmlns="http://www.w3.org/2000/svg">
    ${panel()}
    <rect x="24" y="40" width="392" height="150" rx="14" fill="#fff" stroke="var(--accent-200, #ddd6fe)" stroke-width="1.5"/>
    <!-- clock icon -->
    <circle cx="62" cy="80" r="18" fill="var(--accent-100, #ede9fe)"/>
    <circle cx="62" cy="80" r="10" fill="none" stroke="var(--accent-600, #7c3aed)" stroke-width="2"/>
    <path d="M62 80 V 73 M62 80 l5 3" stroke="var(--accent-600, #7c3aed)" stroke-width="2" stroke-linecap="round"/>
    <!-- count headline -->
    <rect x="94" y="66" width="200" height="13" rx="6" fill="var(--gray-800, #1f2937)"/>
    <rect x="94" y="88" width="260" height="9" rx="4.5" fill="var(--gray-400, #9ca3af)"/>
    <!-- start button -->
    <rect x="300" y="62" width="96" height="34" rx="8" fill="var(--accent-600, #7c3aed)"/>
    <text x="348" y="84" text-anchor="middle" font-family="system-ui, sans-serif" font-size="12" font-weight="700" fill="#fff">Review</text>
    <!-- divider -->
    <rect x="24" y="128" width="392" height="1.5" fill="var(--accent-100, #ede9fe)"/>
    <!-- due topic chips -->
    ${chip(40, 110)}
    ${chip(162, 92)}
    ${chip(266, 128)}
    <!-- schedule note -->
    <rect x="40" y="252" width="300" height="8" rx="4" fill="var(--gray-300, #d1d5db)"/>
    <rect x="40" y="268" width="220" height="8" rx="4" fill="var(--gray-300, #d1d5db)"/>
  </svg>`;
}

/** The cumulative-recall card: weekly + monthly sections with counts. */
function recallMock(): string {
  const section = (y: number, label: string, w: number): string =>
    `<rect x="40" y="${y}" width="360" height="48" rx="10" fill="var(--gray-100, #f3f4f6)"/>` +
    `<rect x="56" y="${y + 13}" width="${w}" height="9" rx="4.5" fill="var(--gray-700, #374151)"/>` +
    `<rect x="56" y="${y + 29}" width="${w + 40}" height="7" rx="3.5" fill="var(--gray-400, #9ca3af)"/>` +
    `<rect x="300" y="${y + 10}" width="84" height="28" rx="8" fill="var(--accent-600, #7c3aed)"/>` +
    `<text x="342" y="${y + 28}" text-anchor="middle" font-family="system-ui, sans-serif" font-size="11" font-weight="700" fill="#fff">${label}</text>`;
  return `<svg ${VB} aria-label="A cumulative-recall card with weekly and monthly sessions" xmlns="http://www.w3.org/2000/svg">
    ${panel()}
    <rect x="24" y="30" width="392" height="238" rx="14" fill="#fff" stroke="var(--accent-200, #ddd6fe)" stroke-width="1.5"/>
    <!-- layers icon -->
    <path d="M50 62 l16 -8 l16 8 l-16 8 Z" fill="var(--accent-500, #8b5cf6)"/>
    <path d="M50 72 l16 8 l16 -8" fill="none" stroke="var(--accent-400, #a78bfa)" stroke-width="2.4" stroke-linejoin="round"/>
    <rect x="94" y="52" width="150" height="12" rx="6" fill="var(--gray-800, #1f2937)"/>
    <rect x="94" y="72" width="280" height="8" rx="4" fill="var(--gray-400, #9ca3af)"/>
    <!-- lagging / priority chip -->
    <rect x="94" y="90" width="150" height="18" rx="9" fill="color-mix(in srgb, #f59e0b 18%, transparent)"/>
    <rect x="106" y="96" width="126" height="7" rx="3.5" fill="#b45309"/>
    ${section(126, 'Weekly', 92)}
    ${section(190, 'Monthly', 104)}
  </svg>`;
}

/** The progress meter + roadmap ticks + data backup chips. */
function progressMock(): string {
  const tick = (x: number, y: number): string =>
    `<circle cx="${x}" cy="${y}" r="11" fill="var(--success-light, #16a34a)"/>` +
    `<path d="M${x - 4.5} ${y} l3 3 L${x + 5} ${y - 4.5}" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>`;
  return `<svg ${VB} aria-label="A completion meter, roadmap ticks, and data backup controls" xmlns="http://www.w3.org/2000/svg">
    ${panel()}
    <!-- meter card -->
    <rect x="24" y="34" width="392" height="70" rx="12" fill="var(--gray-100, #f3f4f6)"/>
    <rect x="40" y="50" width="150" height="11" rx="5" fill="var(--gray-800, #1f2937)"/>
    <rect x="40" y="68" width="90" height="8" rx="4" fill="var(--gray-400, #9ca3af)"/>
    <rect x="40" y="84" width="360" height="10" rx="5" fill="var(--gray-200, #e5e7eb)"/>
    <rect x="40" y="84" width="236" height="10" rx="5" fill="var(--accent-500, #8b5cf6)"/>
    <!-- a row of completed topic ticks -->
    ${tick(48, 148)}
    ${tick(96, 148)}
    ${tick(144, 148)}
    <circle cx="192" cy="148" r="11" fill="none" stroke="var(--gray-400, #9ca3af)" stroke-width="2"/>
    <circle cx="240" cy="148" r="11" fill="none" stroke="var(--gray-400, #9ca3af)" stroke-width="2"/>
    <rect x="60" y="144" width="100" height="8" rx="4" fill="var(--gray-300, #d1d5db)" opacity="0"/>
    <!-- "Your data" bar -->
    <rect x="24" y="190" width="392" height="80" rx="12" fill="var(--gray-100, #f3f4f6)"/>
    <rect x="40" y="206" width="120" height="9" rx="4.5" fill="var(--gray-700, #374151)"/>
    <rect x="40" y="224" width="300" height="7" rx="3.5" fill="var(--gray-400, #9ca3af)"/>
    <rect x="40" y="242" width="80" height="22" rx="7" fill="#fff" stroke="var(--gray-300, #d1d5db)" stroke-width="1.5"/>
    <rect x="54" y="250" width="52" height="7" rx="3.5" fill="var(--gray-600, #4b5563)"/>
    <rect x="130" y="242" width="80" height="22" rx="7" fill="#fff" stroke="var(--gray-300, #d1d5db)" stroke-width="1.5"/>
    <rect x="144" y="250" width="52" height="7" rx="3.5" fill="var(--gray-600, #4b5563)"/>
    <rect x="220" y="242" width="70" height="22" rx="7" fill="#fff" stroke="var(--gray-300, #d1d5db)" stroke-width="1.5"/>
    <rect x="234" y="250" width="42" height="7" rx="3.5" fill="var(--gray-600, #4b5563)"/>
  </svg>`;
}
---

<Layout
  tree={site.tree}
  siteModel={site.siteModel}
  currentRoute="/"
  sectionSlug={site.tree.slug}
  chrome="landing"
>
  <SeoHead
    slot="head"
    displayName="Cortex: Learn Data Science, and Remember It"
    route="/"
    site={siteBase}
    description="A personal, structured data-science learning site: a visual roadmap, interlinked notes, timed quizzes, spaced repetition, and cumulative recall. You write Markdown, the site does the rest."
  />

  {/* ===================== Hero ===================== */}
  <section class="relative overflow-hidden px-4 pb-10 pt-6 sm:px-0 sm:pt-10">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-accent-700 dark:bg-accent-500/15 dark:text-accent-300">
          <span class="h-1.5 w-1.5 rounded-full bg-accent-500"></span>
          Data-science learning, done properly
        </span>
        <h1 class="mt-5 text-4xl font-extrabold leading-[1.05] tracking-tight text-gray-900 sm:text-5xl lg:text-6xl dark:text-gray-50">
          Learn it once.<br />
          <span class="text-accent-600 dark:text-accent-400">Actually remember it.</span>
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-gray-600 sm:text-lg dark:text-gray-300">
          Cortex is a structured data-science syllabus that goes further than notes: a visual roadmap, interlinked lessons, timed quizzes, and spaced repetition that brings a topic back right before you would forget it.
        </p>
        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="/roadmap"
            class="inline-flex items-center gap-2 rounded-lg bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-accent-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950"
          >
            Explore the roadmap
            <span aria-hidden="true">→</span>
          </a>
          <a
            href="/notes"
            class="inline-flex items-center gap-2 rounded-lg border-[1.75px] border-gray-300 px-5 py-2.5 text-sm font-semibold text-gray-700 transition-colors hover:border-accent-400 hover:text-accent-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 dark:border-white/15 dark:text-gray-200 dark:hover:text-accent-200 dark:focus-visible:ring-offset-gray-950"
          >
            Browse the notes
          </a>
        </div>
        <dl class="mt-9 flex flex-wrap gap-x-8 gap-y-3">
          <div>
            <dt class="text-2xl font-extrabold text-gray-900 dark:text-gray-50">{noteCount}</dt>
            <dd class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Interlinked notes</dd>
          </div>
          <div>
            <dt class="text-2xl font-extrabold text-gray-900 dark:text-gray-50">{trackCount}</dt>
            <dd class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Topic tracks</dd>
          </div>
          <div>
            <dt class="text-2xl font-extrabold text-gray-900 dark:text-gray-50">{phaseCount}</dt>
            <dd class="text-xs font-medium uppercase tracking-wide text-gray-500 dark:text-gray-400">Learning phases</dd>
          </div>
        </dl>
      </div>

