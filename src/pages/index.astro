---
/**
 * Landing page (site root `/`): a visual, syllabus-grade learning ROADMAP.
 *
 * Inspired by roadmap.sh / neetcode topic graphs: a central "spine" of
 * main-track topics (studied top-to-bottom) with sub-topics branching off. It
 * is a single hand-authored, fully static inline SVG (same convention as the
 * site logo) so there are no runtime deps and it themes + scales cleanly.
 *
 * Every node is CLICKABLE and opens a modal (native <dialog>, same pattern as
 * the search dialog) listing the concrete concepts to learn for that topic,
 * turning the map into an actual syllabus guide. When the topic already has
 * notes, the modal also shows a "Read notes" link.
 *
 * SYLLABUS SOURCE: the track list and every concept list below are derived
 * from the CampusX Data Science Mentorship Program (DSMP 2.0) curriculum.
 * Main-track nodes mirror the program's subject areas (roughly two weeks of
 * study each); branch nodes mirror its individual sessions; the modal concept
 * list mirrors that session's topic bullets.
 *
 * Node positions and connector paths are COMPUTED in the frontmatter from the
 * declared `spine` data, so the layout stays maintainable: edit the syllabus
 * data, not pixel coordinates. Reuses the shared Layout; `prerender = true`.
 */
import { loadSite, renderNote } from '@/lib/content';
import Layout from '@/components/Layout.astro';
import SeoHead from '@/components/SeoHead.astro';
import { MIN_HEADING_DEPTH } from '@/lib/toc';
import { matchTopicPrepared, preparePool } from '@/lib/syllabus/match';
import type { Candidate, PreparedPool } from '@/lib/syllabus/match';
import { spine, phases, conceptLabel } from '@/data/roadmap';
import type { Concept, Difficulty, Step, Tier, Topic } from '@/data/roadmap';
import type { CategoryNode, TreeNode } from '@/lib/ingest/types';

export const prerender = true;

const site = await loadSite();
const siteBase = Astro.site?.href;

/**
 * Two Display_Name (lowercased) -> route indexes built from the published
 * content tree, at ANY depth:
 *
 *   - `noteRoutes`     a single note page, e.g. "ANOVA" -> /notes/.../anova
 *   - `categoryRoutes` a folder listing page, e.g. "Statistics & Probability"
 *
 * Notes win over categories when resolving a roadmap node (see `routeFor`), so
 * a leaf topic deep-links straight to its note rather than dumping the reader
 * on the parent folder. Because lookup falls back to the node's own label, a
 * roadmap node lights up automatically as soon as a note with a matching
 * Display_Name is added: no edit to this file required.
 */
const categoryRoutes = new Map<string, string>();
const noteRoutes = new Map<string, string>();
/** Reverse lookup, for naming a note when all we hold is its route. */
const noteNameByRoute = new Map<string, string>();

function indexTree(nodes: readonly TreeNode[]): void {
  for (const node of nodes) {
    const key = node.displayName.trim().toLowerCase();
    if (node.kind === 'category') {
      if (!categoryRoutes.has(key)) categoryRoutes.set(key, node.route);
      indexTree(node.children);
    } else {
      if (!noteRoutes.has(key)) noteRoutes.set(key, node.route);
      noteNameByRoute.set(node.route, node.displayName);
    }
  }
}
indexTree(site.tree.children);

/** One linkable section inside a note: its heading text and `route#anchor`. */
interface SectionLink {
  text: string;
  href: string;
  /** Heading depth, so the modal can visually subordinate nested sections. */
  depth: number;
}

/**
 * Per-note section indexes, built by RENDERING each note so the anchors are the
 * real `rehype-slug` ids the note page emits. Deriving them by hand here would
 * risk drifting out of sync with what the note page actually publishes.
 *
 * Only notes are rendered (a dozen files today). If the note count grows into
 * the hundreds this loop becomes the homepage's build cost, at which point the
 * heading data is better threaded through `loadSite()` once.
 */
const sectionsByRoute = new Map<string, SectionLink[]>();

for (const data of site.byRoute.values()) {
  if (data.kind !== 'note') continue;
  const rendered = await renderNote(data.entry);
  const sections: SectionLink[] = [];
  for (const heading of rendered.headings) {
    // Skip the note title (depth 1); it is the page itself, not a section.
    if (heading.depth < MIN_HEADING_DEPTH) continue;
    sections.push({
      text: heading.text,
      href: `${data.route}#${heading.slug}`,
      depth: heading.depth,
    });
  }
  sectionsByRoute.set(data.route, sections);
}

/**
 * Match pools, normalized once each rather than once per bullet.
 *
 *   - by note route     the note's own headings.
 *   - by category route every heading of every note beneath it, merged. This is
 *     what lets a main-track node (which links to the folder, not to one note)
 *     still deep-link its bullets into whichever note covers them.
 */
/** Headings of one note as matcher candidates, tagged with the note they are in. */
function candidatesFor(route: string, title: string): Candidate<string>[] {
  return (sectionsByRoute.get(route) ?? []).map((s) => ({
    text: s.text,
    ref: s.href,
    group: route,
    groupTitle: title,
    depth: s.depth,
  }));
}

const poolByRoute = new Map<string, PreparedPool<string>>();
const poolByCategory = new Map<string, PreparedPool<string>>();

function collectCategoryCandidates(node: CategoryNode): Candidate<string>[] {
  const acc: Candidate<string>[] = [];
  for (const child of node.children) {
    if (child.kind === 'category') {
      acc.push(...collectCategoryCandidates(child));
      continue;
    }
    const own = candidatesFor(child.route, child.displayName);
    poolByRoute.set(child.route, preparePool(own));
    acc.push(...own);
  }
  poolByCategory.set(node.route, preparePool(acc));
  return acc;
}
collectCategoryCandidates(site.tree);


// The syllabus itself lives in `src/data/roadmap.ts` so the audit script can
// read the same declaration this page renders. See that file for provenance.

/** What a resolved roadmap link points at, so the modal can label its CTA. */
type LinkKind = 'note' | 'category';
interface Target {
  href: string | null;
  linkKind: LinkKind | null;
}

/** Roadmap labels whose `match` could not be resolved, reported during build. */
const unresolved: string[] = [];

/**
 * Resolve a topic to the page it should open. `match` overrides the label when
 * the roadmap wording differs from the content's Display_Name (e.g. "Chi-square
 * Test" -> the "Chi-Square Tests" note).
 *
 * `preferCategory` is set for MAIN TRACKS, and exists because the content folders
 * are deliberately named after the tracks: a folder and a note can share a name
 * ("Descriptive Statistics" is both). A track represents the whole area, so it
 * must open the folder; a branch represents one note, so it must open the note.
 * Without this the track would silently link to the first of its own notes.
 */
function targetFor(t: { label: string; match?: string }, preferCategory = false): Target {
  const key = (t.match ?? t.label).trim().toLowerCase();
  const note = noteRoutes.get(key);
  const category = categoryRoutes.get(key);

  const first = preferCategory ? category : note;
  const second = preferCategory ? note : category;
  const firstKind: LinkKind = preferCategory ? 'category' : 'note';
  const secondKind: LinkKind = preferCategory ? 'note' : 'category';

  if (first) return { href: first, linkKind: firstKind };
  if (second) return { href: second, linkKind: secondKind };
  // An explicit `match` that resolves to nothing is a typo or a renamed note,
  // not an intentional "no notes yet" node, so surface it.
  if (t.match) unresolved.push(`${t.label} -> ${t.match}`);
  return { href: null, linkKind: null };
}

// ---- Layout geometry (SVG user units; viewBox scales it responsively) ------
const W = 1000;
const SPINE_X = W / 2;
const TOP = 40;
const BOTTOM_PAD = 40;
const SPINE_W = 250;
const SPINE_H = 50;
const SUB_W = 250;
const SUB_H = 36;
const SUB_GAP_Y = 46;
const SIDE_OFFSET = 285;
// Clear vertical space left between one step's branch block and the next one's.
const MIN_STEP_GAP = 52;

/**
 * Vertical half-height a step occupies: its own box, or its tallest branch
 * column, whichever is larger. Steps are then spaced by these half-heights so
 * branch lists never collide however long the syllabus grows.
 */
function halfHeightOf(step: Step): number {
  const branches = Math.max(step.left?.length ?? 0, step.right?.length ?? 0);
  const branchHalf = branches > 0 ? ((branches - 1) * SUB_GAP_Y) / 2 + SUB_H / 2 : 0;
  return Math.max(SPINE_H / 2, branchHalf);
}

/** Each step paired with the spine y-coordinate it was assigned. */
interface StepLayout {
  step: Step;
  y: number;
}

const stepLayouts: StepLayout[] = [];
let cursor = TOP;
for (const step of spine) {
  const half = halfHeightOf(step);
  cursor += half;
  stepLayouts.push({ step, y: cursor });
  cursor += half + MIN_STEP_GAP;
}
const H = cursor - MIN_STEP_GAP + BOTTOM_PAD;

// The axon trunk runs between the CENTERS of the first and last track cells, so
// it never pokes out past the top of the first cell or the bottom of the last
// (those stubs looked like loose ends). The cells are opaque and drawn on top,
// so the trunk simply disappears under them at each end.
const trunkTop = stepLayouts[0]?.y ?? TOP;
const trunkBottom = stepLayouts[stepLayouts.length - 1]?.y ?? TOP;

// A gently CURVY trunk: it passes through SPINE_X at every track (so each cell
// still sits on the fibre) but bows a little to alternating sides in the gaps
// between tracks, so the axon meanders like a real nerve instead of a ruler.
// Signal train timing. TRUNK_DUR is how long ONE spark takes to travel the
// whole trunk (slow = calm). TRUNK_INTERVAL is how often a new spark is
// released, so DUR/INTERVAL sparks ride the fibre at once (a periodic stream).
const TRUNK_DUR = 16; // seconds, one spark top -> bottom (slower)
const TRUNK_INTERVAL = 2; // seconds between spark releases
const TRUNK_SPARKS = Math.round(TRUNK_DUR / TRUNK_INTERVAL); // sparks visible at once
const TRUNK_BOW = 26; // px of horizontal sway at each mid-gap
const trunkPath = (() => {
  const ys = stepLayouts.map((s) => s.y);
  if (ys.length === 0) return `M ${SPINE_X} ${trunkTop} L ${SPINE_X} ${trunkBottom}`;
  let d = `M ${SPINE_X} ${trunkTop} L ${SPINE_X} ${ys[0]}`;
  for (let i = 0; i < ys.length - 1; i++) {
    const y0 = ys[i]!;
    const y1 = ys[i + 1]!;
    const midY = (y0 + y1) / 2;
    const bowX = SPINE_X + (i % 2 === 0 ? TRUNK_BOW : -TRUNK_BOW);
    // Cubic that leaves cell i vertically, bows out at the mid-gap, and re-enters
    // cell i+1 vertically, keeping both endpoints exactly on SPINE_X.
    d += ` C ${bowX} ${y0 + (midY - y0) * 0.5}, ${bowX} ${y1 - (y1 - midY) * 0.5}, ${SPINE_X} ${y1}`;
  }
  d += ` L ${SPINE_X} ${trunkBottom}`;
  return d;
})();

interface PlacedNode {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  label: string;
  href: string | null;
  linkKind: LinkKind | null;
  main: boolean;
  /** 'core' (default) or 'advanced'; drives the deferrable-topic marker. */
  tier: Tier;
  /** Optional material difficulty; drives the colour stripe + modal badge. */
  difficulty?: Difficulty;
  /** Optional prerequisite labels (linked in the modal where resolvable). */
  prerequisites?: string[];
  /** Zero-based index of the track this node belongs to (scroll-reveal group). */
  track: number;
  /** Reveal order within the track: 0 = main cell, 1..n = sub-topics (stagger). */
  revealIndex: number;
  concepts: Concept[];
}
interface Connector {
  /** Stable id so a signal spark can follow this dendrite via <mpath>. */
  id?: string;
  d: string;
  dashed: boolean;
  /** Branch (dendrite) connectors carry their terminal point, where a synaptic
   *  bouton is drawn; `live` says the target topic has a note (bright bouton). */
  bouton?: { x: number; y: number; live: boolean };
  /** Seconds into the trunk's loop when the trunk signal reaches this branch's
   *  track, so the branch spark fires as the trunk pulse passes (a cascade). */
  beginAt?: number;
  /** Scroll-reveal grouping: which track, and the stagger order (matches its
   *  sub-topic) so the dendrite draws in with its cell. */
  track?: number;
  revealIndex?: number;
}

const nodes: PlacedNode[] = [];
const connectors: Connector[] = [];
/** Main-track node id -> the notes that track covers, for its jump list. */
const notesByTrack = new Map<string, SectionLink[]>();
/** Main-track node id -> `{ advanced, total }` over its sub-topics. */
const advancedRatioByTrack = new Map<string, { advanced: number; total: number }>();
let idc = 0;

stepLayouts.forEach(({ step, y }, trackIndex) => {
  const stepNode: PlacedNode = {
    id: `n${idc++}`,
    x: SPINE_X,
    y,
    w: SPINE_W,
    h: SPINE_H,
    label: step.label,
    ...targetFor(step, true),
    main: true,
    tier: step.tier ?? 'core',
    difficulty: step.difficulty,
    prerequisites: step.prerequisites,
    track: trackIndex,
    revealIndex: 0, // main cell reveals first in its track
    concepts: step.concepts,
  };
  nodes.push(stepNode);

  // No per-step spine segment here: the continuous axon trunk (drawn once in
  // the SVG, behind the cells) is the spine now, so the old segments would just
  // double the line and show through the gaps between cells.

  // Reveal order within this track: main cell is 0, sub-topics follow (1..n)
  // in placement order (left column then right), so they cascade after the main
  // cell when the signal reaches the track.
  let subReveal = 1;
  const place = (topics: Topic[], side: -1 | 1) => {
    const colX = SPINE_X + side * SIDE_OFFSET;
    const totalH = (topics.length - 1) * SUB_GAP_Y;
    const startY = y - totalH / 2;
    topics.forEach((t, j) => {
      const ty = startY + j * SUB_GAP_Y;
      nodes.push({
        id: `n${idc++}`,
        x: colX,
        y: ty,
        w: SUB_W,
        h: SUB_H,
        label: t.label,
        ...targetFor(t),
        main: false,
        tier: t.tier ?? 'core',
        difficulty: t.difficulty,
        prerequisites: t.prerequisites,
        track: trackIndex,
        revealIndex: subReveal++,
        concepts: t.concepts,
      });
      const spineEdge = SPINE_X + side * (SPINE_W / 2);
      const subEdge = colX - side * (SUB_W / 2);
      const midX = (spineEdge + subEdge) / 2;
      // A trunk spark reaches this track at time f*TRUNK_DUR after its release.
      // Sparks release every TRUNK_INTERVAL, so the branch fires on that same
      // interval, phase-offset to the moment a spark actually arrives.
      const span = trunkBottom - trunkTop || 1;
      const arrival = TRUNK_DUR * ((y - trunkTop) / span);
      const beginAt = ((arrival % TRUNK_INTERVAL) + TRUNK_INTERVAL) % TRUNK_INTERVAL;
      connectors.push({
        id: `e${idc}`,
        d: `M ${spineEdge} ${y} C ${midX} ${y}, ${midX} ${ty}, ${subEdge} ${ty}`,
        dashed: false,
        // The dendrite terminates in a synaptic bouton at the topic's edge; it
        // glows when the topic has a note (resolved href), else it stays dim.
        bouton: { x: subEdge, y: ty, live: targetFor(t).href !== null },
        beginAt,
        track: trackIndex,
        revealIndex: subReveal - 1, // matches the sub-topic just pushed above
      });
    });
  };
  if (step.left) place(step.left, -1);
  if (step.right) place(step.right, 1);

  /**
   * The track's own notes, taken from the notes its SUB-TOPICS resolve to.
   *
   * The category cannot supply this: three of these tracks share one folder, so
   * listing the folder's contents would show each track the other two's notes.
   * The sub-topics are the accurate statement of what this track covers.
   */
  const trackNotes: SectionLink[] = [];
  const seenNote = new Set<string>();
  for (const topic of [...(step.left ?? []), ...(step.right ?? [])]) {
    const { href, linkKind } = targetFor(topic);
    if (linkKind !== 'note' || href === null || seenNote.has(href)) continue;
    seenNote.add(href);
    trackNotes.push({ text: noteNameByRoute.get(href) ?? topic.label, href, depth: 2 });
  }
  notesByTrack.set(stepNode.id, trackNotes);

  const branches = [...(step.left ?? []), ...(step.right ?? [])];
  advancedRatioByTrack.set(stepNode.id, {
    advanced: branches.filter((t) => t.tier === 'advanced').length,
    total: branches.length,
  });
});

// ---- Simple view (phase bands) --------------------------------------------
/**
 * The same tracks as the detailed view, grouped into the journey's phases and
 * rendered as PLAIN HTML rather than SVG. HTML is what makes this view actually
 * responsive: track chips reflow with `flex-wrap`, phase bands stack, and text
 * never clips because the browser measures it. The detailed view stays SVG
 * (its spine geometry needs absolute positioning); this one does not.
 *
 * Chips REUSE the detailed view's node ids, so a click opens the same modal
 * from the same payload with nothing extra to maintain.
 */
const mainNodes = nodes.filter((n) => n.main);
const nodeByLabel = new Map(mainNodes.map((n) => [n.label, n]));

interface PhaseBand {
  name: string;
  hue: string;
  tracks: PlacedNode[];
}

// Resolve each phase's track labels to their placed nodes, and prove the
// grouping matches the spine: every track in exactly one phase, no unknowns,
// none left over. A drift here would silently drop a track from the overview.
const seenInPhase = new Set<string>();
const phaseBands: PhaseBand[] = phases.map((p) => ({
  name: p.name,
  hue: p.hue,
  tracks: p.tracks.map((label) => {
    const node = nodeByLabel.get(label);
    if (!node) throw new Error(`[roadmap] phase "${p.name}" names unknown track "${label}"`);
    if (seenInPhase.has(label)) throw new Error(`[roadmap] track "${label}" is in two phases`);
    seenInPhase.add(label);
    return node;
  }),
}));
const ungrouped = mainNodes.filter((n) => !seenInPhase.has(n.label));
if (ungrouped.length > 0) {
  throw new Error(`[roadmap] ${ungrouped.length} track(s) missing from phases: ` +
    ungrouped.map((n) => n.label).join(', '));
}

// Fail loudly-but-safely: a stale `match` yields a dead node, which is easy to
// miss in a graph this size, so name the offenders in the build log.
if (unresolved.length > 0) {
  console.warn(
    `[roadmap] ${unresolved.length} topic(s) have a "match" that resolves to no note or category:\n  ` +
      [...new Set(unresolved)].join('\n  '),
  );
}

/**
 * How many roadmap nodes point at each note. This is what distinguishes the two
 * kinds of branch node without needing a hand-maintained flag:
 *
 *   - SOLE OWNER (count 1): the node covers the whole note, so its outline is
 *     useful context. "ANOVA" is the ANOVA note.
 *   - SLICE (count > 1): several nodes carve up one note, so that note's outline
 *     describes its siblings as much as itself and would mislead. "Central
 *     Tendency & Spread" and "Bivariate Analysis" are both parts of one note.
 */
const nodesPerNote = new Map<string, number>();
for (const n of nodes) {
  if (n.linkKind !== 'note' || n.href === null) continue;
  nodesPerNote.set(n.href, (nodesPerNote.get(n.href) ?? 0) + 1);
}

// Measured after the build so the reach of the matcher is reported, not assumed.
let linkableBullets = 0;
let deepLinked = 0;
/** Declared `at` overrides that matched nothing: stale, so surfaced. */
const deadAnchors: string[] = [];

// Data the client island reads to populate the modal (keyed by node id). A
// concept carries an `href` only when the matcher placed it in a real section.
const nodeData = Object.fromEntries(
  nodes.map((n) => {
    // A note-linked node searches its own note; a category-linked node searches
    // every note in that category, and must win unambiguously to avoid landing
    // on the wrong document.
    const pool =
      n.linkKind === 'note'
        ? poolByRoute.get(n.href!)
        : n.linkKind === 'category'
          ? poolByCategory.get(n.href!)
          : undefined;
    const requireUnique = n.linkKind === 'category';

    const concepts = n.concepts.map((c) => {
      const text = conceptLabel(c);
      if (!pool) return { text };
      linkableBullets++;

      // An explicit `at` is an author override for the rare case the matcher
      // gets wrong; otherwise the bullet's own wording is matched.
      const query = typeof c === 'string' ? text : c.at;
      const hit = matchTopicPrepared(query, pool, { requireUnique });

      if (!hit) {
        if (typeof c !== 'string') deadAnchors.push(`${n.label}: "${c.label}" -> at "${c.at}"`);
        return { text };
      }
      deepLinked++;
      return { text, href: hit.ref };
    });

    return [
      n.id,
      {
        label: n.label,
        href: n.href,
        linkKind: n.linkKind,
        tier: n.tier,
        /** Material difficulty (beginner/intermediate/advanced), if set. */
        difficulty: n.difficulty,
        /** Prerequisite labels resolved to routes where a note/category matches. */
        prerequisites: (n.prerequisites ?? []).map((label) => {
          const key = label.trim().toLowerCase();
          return { label, href: noteRoutes.get(key) ?? categoryRoutes.get(key) ?? null };
        }),
        /**
         * For a main track: how many of its sub-topics are deferrable, out of how
         * many. A track is never itself "advanced", so this is the useful signal
         * at track level: "12 sub-topics, 5 of which can wait".
         */
        advanced: n.main ? advancedRatioByTrack.get(n.id) : undefined,
        concepts,
        /**
         * The overview list, by node tier:
         *
         *   TRACK       the notes this track covers.
         *   NOTE-LEVEL  that note's section outline (sole owner of the note).
         *   SLICE       nothing. Its bullets already deep-link into the parts of
         *               the note it covers, and the full outline would advertise
         *               its sibling slices' content as if it were its own.
         */
        sections: n.main
          ? n.linkKind === 'note'
            ? (sectionsByRoute.get(n.href!) ?? [])
            : (notesByTrack.get(n.id) ?? [])
          : n.linkKind === 'note' && nodesPerNote.get(n.href!) === 1
            ? (sectionsByRoute.get(n.href!) ?? [])
            : [],
      },
    ];
  }),
);

if (deadAnchors.length > 0) {
  console.warn(
    `[roadmap] ${deadAnchors.length} concept(s) declare an "at" override that matches nothing:\n  ` +
      deadAnchors.join('\n  '),
  );
}

const pct = linkableBullets > 0 ? Math.round((deepLinked / linkableBullets) * 100) : 0;
console.log(
  `[roadmap] ${nodes.length} nodes, ${nodes.filter((n) => n.href).length} linked ` +
    `(${nodes.filter((n) => n.linkKind === 'note').length} to a note). ` +
    `${deepLinked}/${linkableBullets} bullets auto-linked to a heading (${pct}%). ` +
    `Run \`npm run audit:syllabus\` for the mapping report.`,
);

const availableSteps = nodes.filter((n) => n.main && n.href).length;
const totalSteps = nodes.filter((n) => n.main).length;
---

<Layout
  tree={site.tree}
  siteModel={site.siteModel}
  currentRoute="/"
  sectionSlug={site.tree.slug}
  chrome="landing"
>
  <SeoHead
    slot="head"
    displayName="Cortex: Learning Roadmap"
    route="/"
    site={siteBase}
    description="A visual, syllabus-grade data-science learning roadmap. Click any topic to see the concepts to learn, and jump into the notes."
  />

  {/* ---- Hero ---- */}
  <section class="px-4 pb-6 pt-2 sm:px-0 sm:pb-8">
    <span class="inline-flex items-center rounded-full bg-violet-100 px-3 py-1 text-xs font-semibold uppercase tracking-wider text-violet-700 dark:bg-violet-500/15 dark:text-violet-300">
      Learning roadmap
    </span>
    <h1 class="mt-4 text-4xl font-extrabold tracking-tight text-gray-900 sm:text-5xl lg:text-6xl dark:text-gray-50">
      Cortex
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-gray-600 sm:text-lg dark:text-gray-300">
      A personal, structured data-science syllabus. Follow the map from Python
      foundations to deployment. Start with the <strong class="font-semibold text-gray-900 dark:text-gray-100">simple view</strong> for
      the shape of it, switch to detailed for every sub-topic, and <strong class="font-semibold text-gray-900 dark:text-gray-100">click any topic</strong> to
      see exactly what to learn and jump straight into the notes.
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <a
        href="/notes"
        class="inline-flex items-center gap-2 rounded-lg bg-violet-600 px-5 py-2.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-violet-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-950"
      >
        Browse all notes
        <span aria-hidden="true">→</span>
      </a>
      <span class="rounded-full border border-gray-200 px-3 py-1.5 text-sm text-gray-500 dark:border-white/10 dark:text-gray-400">
        <strong class="font-semibold text-gray-700 dark:text-gray-200">{availableSteps}</strong> of {totalSteps} core topics have notes
      </span>
    </div>
  </section>

  {/* ---- Roadmap graph ---- */}
  <section class="roadmap border-t border-gray-200 px-4 pb-10 pt-6 sm:px-0 sm:pt-8 dark:border-white/10">
    {/*
      Controls row: the view toggle sits FIRST, right under the topic count, so
      the two most-used controls stay together. The hint follows it, wrapping to
      its own line on a phone (where a toggle + a full sentence cannot share a
      row) and sitting inline on wider screens.
    */}
    <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:gap-3">
      <div
        class="inline-flex shrink-0 self-start rounded-lg border border-gray-200 bg-gray-50 p-1 dark:border-white/10 dark:bg-white/5"
        role="group"
        aria-label="Roadmap detail level"
      >
        <button
          type="button"
          data-rm-view="simple"
          aria-pressed="true"
          class="rm-view-btn rounded-md px-3 py-1.5 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-600"
        >
          Simple
        </button>
        <button
          type="button"
          data-rm-view="detailed"
          aria-pressed="false"
          class="rm-view-btn rounded-md px-3 py-1.5 text-sm font-semibold transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-600"
        >
          Detailed
        </button>
      </div>
      <p class="text-sm text-gray-500 dark:text-gray-400" data-rm-view-hint>
        {totalSteps} core topics at a glance. Switch to detailed for every sub-topic.
      </p>
    </div>

    {/* Legend: below the toggle, wrapping freely. */}
    <div class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-2">
      {/*
        "Notes available" = a FILLED node. Its colour differs by view: each
        phase's own hue in the simple view, dark violet in the detailed spine.
        So the swatch matches the ACTIVE view — the island shows a swatch
        carrying ALL SIX phase hues (in phase order) with the simple view, and
        the violet one with the detailed view, via the data-rm-*-only tagging.
        A wider pill makes every band of colour legible.
      */}
      <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-300">
        <span data-rm-simple-only class="h-2.5 w-6 rounded-full" style="background: linear-gradient(90deg, #8b5cf6 0 16.6%, #0ea5e9 16.6% 33.3%, #14b8a6 33.3% 50%, #c2842a 50% 66.6%, #c25585 66.6% 83.3%, #3f9e6a 83.3% 100%)" aria-hidden="true"></span>
        <span data-rm-detailed-only hidden class="h-2.5 w-2.5 rounded-full bg-violet-600" aria-hidden="true"></span>
        Notes available
      </span>
      <span class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-300">
        <span class="h-2.5 w-2.5 rounded-full border border-dashed border-gray-400 dark:border-gray-500" aria-hidden="true"></span>
        Coming soon
      </span>
      {/*
        Difficulty legend: the coloured nucleus dot inside each cell. It only
        exists in the DETAILED view (the simple view has no per-node nucleus),
        so these three are `data-rm-detailed-only` and the island hides them in
        the simple view. Hues match the nucleus + note-page badge + modal.
      */}
      <span
        data-rm-detailed-only
        hidden
        class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-300"
      >
        <span class="h-2.5 w-2.5 rounded-full" style="background:#10b981" aria-hidden="true"></span>
        Beginner
      </span>
      <span
        data-rm-detailed-only
        hidden
        class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-300"
      >
        <span class="h-2.5 w-2.5 rounded-full" style="background:#3b82f6" aria-hidden="true"></span>
        Intermediate
      </span>
      <span
        data-rm-detailed-only
        hidden
        class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-300"
      >
        <span class="h-2.5 w-2.5 rounded-full" style="background:#ec4899" aria-hidden="true"></span>
        Advanced
      </span>
      {/*
        Tier legend. The amber notch only appears in the DETAILED view (the
        simple view lists whole tracks, so per-sub-topic tiering has nowhere to
        show), so these two items are tagged `data-rm-detailed-only` and the
        island hides them while the simple view is active.
      */}
      <span
        data-rm-detailed-only
        hidden
        class="inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-300"
      >
        <span class="h-3.5 w-5 rounded-sm border border-dashed border-amber-600 dark:border-amber-400" aria-hidden="true"></span>
        Optional (safe to skip)
      </span>
      <span
        data-rm-detailed-only
        hidden
        class="w-full text-xs text-gray-500 sm:w-auto dark:text-gray-400"
      >
        Unmarked topics are core: fundamentals every data scientist should know.
      </span>
    </div>

    {/*
      Simple view: phase bands (plain HTML so it reflows). Each band is one
      stage of the journey; its track chips wrap across as many rows as the
      width allows, so this is one column on a phone and up to three across on a
      wide screen with no clipping and no fixed geometry.
    */}
    <div
      data-rm-pane="simple"
      role="group"
      aria-label={`Data-science learning roadmap, simple view: ${totalSteps} core topics in ${phaseBands.length} phases.`}
    >
      <ol class="flex flex-col gap-3">
        {
          phaseBands.map((band, bi) => (
            <li
              class="rm-band relative overflow-hidden rounded-xl px-3 py-3 sm:px-4"
              style={`--phase-hue: ${band.hue}`}
            >
              <div class="flex flex-col gap-2.5 sm:flex-row sm:items-center sm:gap-4">
                <p class="rm-band-name flex shrink-0 items-baseline gap-2 sm:w-40 sm:flex-col sm:gap-0.5">
                  <span class="text-[0.7rem] font-bold uppercase tracking-wider">{band.name}</span>
                  <span class="text-[0.65rem] font-medium text-gray-400 dark:text-gray-500">
                    {`Phase ${bi + 1}`}
                  </span>
                </p>
                <ul class="flex flex-1 flex-wrap gap-2">
                  {band.tracks.map((n) => (
                    <li>
                      <button
                        type="button"
                        class={`rm-chip ${n.href ? 'rm-avail' : 'rm-soon'}`}
                        aria-label={`${n.label}: view concepts`}
                        data-rm-node={n.id}
                      >
                        <span>{n.label}</span>
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    {/*
      Detailed view: the full spine. It is a wide fixed-ratio graph, so on a
      phone we let it scroll HORIZONTALLY inside its own box (with a readable
      min-width) rather than shrinking every label to an illegible size. The
      simple view above is the phone-friendly default; this is the opt-in.
    */}
    <div data-rm-pane="detailed" hidden>
    <div class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:overflow-visible sm:px-0">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      class="h-auto w-full min-w-[680px] sm:min-w-0"
      role="group"
      aria-label="Data-science learning roadmap. Select a topic to see its concepts."
      font-family="var(--font-sans)"
    >
      {/*
        Axon trunk: one continuous fibre down the spine (a myelinated sheath +
        bright inner core), drawn UNDER the cells so opaque cell bodies paint
        over it. It is the ONLY spine line (the old per-step segments were
        removed) and carries the firing signal + nodes of Ranvier so the whole
        path reads as one nerve.
      */}
      <path id="rm-axon" class="rm-trunk" d={trunkPath} />
      <path class="rm-trunk-core" d={trunkPath} />
      {/* Nodes of Ranvier: myelin gaps banding the trunk between tracks. */}
      {
        stepLayouts.slice(0, -1).map((s, i) => {
          const nextY = stepLayouts[i + 1]!.y;
          const midY = (s.y + SPINE_H / 2 + (nextY - SPINE_H / 2)) / 2;
          return <line class="rm-ranvier" x1={SPINE_X - 6} y1={midY} x2={SPINE_X + 6} y2={midY} />;
        })
      }
      {/* Action potentials: a periodic TRAIN. A new spark is released every
          TRUNK_INTERVAL seconds and takes TRUNK_DUR to reach the bottom, so a
          steady stream of sparks rides the fibre one after another. */}
      {
        Array.from({ length: TRUNK_SPARKS }).map((_, k) => (
          <circle
            class={`rm-signal rm-signal-gated${k % 2 === 0 ? '' : ' rm-signal-trail'}`}
            // NO cx/cy: animateMotion supplies ABSOLUTE coordinates from the
            // trunk path. Adding a cx/cy here would OFFSET the path (the browser
            // adds them), which is what pushed the spark far to the right. The
            // resting-frame speck is hidden by the gating opacity instead.
            r={k % 2 === 0 ? 3 : 2.4}
            data-rm-track="0"
          >
            <animateMotion
              dur={`${TRUNK_DUR}s`}
              begin={`-${k * TRUNK_INTERVAL}s`}
              repeatCount="indefinite"
              path={trunkPath}
            />
          </circle>
        ))
      }

      {
        connectors.map((c) => (
          <>
            <path
              id={c.id}
              d={c.d}
              fill="none"
              class={`${c.dashed ? 'rm-edge rm-edge-dashed' : 'rm-edge'} rm-reveal`}
              stroke-width="2"
              stroke-dasharray={c.dashed ? '5 5' : undefined}
              data-rm-track={c.track}
              style={c.revealIndex !== undefined ? `--ri:${c.revealIndex}` : undefined}
            />
            {/* Synaptic bouton at the dendrite terminal (branch connectors only). */}
            {c.bouton && (
              <circle
                cx={c.bouton.x}
                cy={c.bouton.y}
                r="3"
                class={`${c.bouton.live ? 'rm-bouton rm-bouton-live' : 'rm-bouton'} rm-reveal`}
                data-rm-track={c.track}
                style={c.revealIndex !== undefined ? `--ri:${c.revealIndex}` : undefined}
              />
            )}
            {/* A synaptic spark fires down each LIVE dendrite the moment the
                trunk pulse reaches its track (begin = beginAt), then travels the
                branch quickly and rests at the bouton until the next pass. Same
                6s cycle as the trunk, so it reads as the trunk triggering it.
                Coming-soon branches (no note yet) carry no signal. */}
            {c.id && c.bouton?.live && (
              <circle
                class="rm-signal rm-signal-branch rm-signal-gated"
                // NO cx/cy: the inline `path` gives ABSOLUTE coordinates, so a
                // cx/cy would offset the whole path (pushing the spark off the
                // dendrite). The resting-frame speck is hidden by the gating.
                r="2"
                data-rm-track={c.track}
              >
                {/*
                  Path `d` DIRECTLY on animateMotion (not <mpath>): keyPoints are
                  unreliable via <mpath>. The spark travels the branch
                  (trunk -> bouton) in the first half, then rests at the bouton,
                  exactly along the visible dendrite line.
                */}
                <animateMotion
                  dur={`${TRUNK_INTERVAL}s`}
                  begin={`${c.beginAt ?? 0}s`}
                  repeatCount="indefinite"
                  path={c.d}
                  keyPoints="0;1;1"
                  keyTimes="0;0.5;1"
                  calcMode="linear"
                />
              </circle>
            )}
          </>
        ))
      }
      {
        nodes.map((n) => {
          const x = n.x - n.w / 2;
          const y = n.y - n.h / 2;
          const state = n.href ? 'rm-avail' : 'rm-soon';
          const kind = n.main ? 'rm-node-main' : 'rm-node-sub';
          const adv = n.tier === 'advanced';
          return (
            /*
              The tier is spoken in `aria-label`, not just coloured. Colour alone
              would make this indicator invisible to a screen reader and
              unreliable for colour-blind readers.
            */
            <g
              class={`rm-node ${kind} ${state} ${adv ? 'rm-adv' : ''} rm-reveal`}
              role="button"
              tabindex="0"
              aria-label={`${n.label}${adv ? ', optional' : ''}: view concepts`}
              data-rm-node={n.id}
              data-rm-track={n.track}
              style={`--ri:${n.revealIndex}`}
            >
              {/* Cell body (soma). Fully rounded so it reads as a neuron, not a
                  box. Optional cells get the dashed amber membrane via `.rm-adv`. */}
              <rect x={x} y={y} width={n.w} height={n.h} rx={n.h / 2} class="rm-rect" />
              {/*
                Difficulty nucleus: a coloured dot (green/blue/pink) with a soft
                halo, set just inside the cell's INNER edge (the side facing the
                spine). It is the difficulty axis, separate from the optional
                membrane. Purely visual; the modal speaks the level in words.
              */}
              {n.difficulty && (
                <g class={`rm-nucleus rm-nucleus-${n.difficulty}`}>
                  <circle cx={n.x < SPINE_X ? x + n.w - 15 : x + 15} cy={n.y} r="8" class="rm-nucleus-halo" />
                  <circle cx={n.x < SPINE_X ? x + n.w - 15 : x + 15} cy={n.y} r="4" class="rm-nucleus-dot" />
                </g>
              )}
              {/*
                Optional (safe to skip) is shown by the DASHED AMBER MEMBRANE on
                the cell outline (see `.rm-adv .rm-rect`), a single cue reading
                "not fully wired in". The accessible name also says "optional",
                so it is never colour-only.
              */}
              <text
                x={n.difficulty ? (n.x < SPINE_X ? n.x - 8 : n.x + 8) : n.x}
                y={n.y}
                class={n.main ? 'rm-label rm-label-main' : 'rm-label'}
                text-anchor="middle"
                dominant-baseline="central"
              >
                {n.label}
              </text>
            </g>
          );
        })
      }
    </svg>
    </div>
    </div>
  </section>

  {/* ---- Topic concept modal (populated by the island) ---- */}
  <dialog
    data-rm-dialog
    aria-labelledby="rm-modal-title"
    class="mx-auto mt-[6vh] w-[calc(100%-1.5rem)] max-w-[520px] overflow-hidden rounded-2xl border border-gray-200 bg-white p-0 text-left shadow-2xl backdrop:bg-gray-900/50 backdrop:backdrop-blur-sm sm:mt-[10vh] sm:w-[calc(100%-2rem)] dark:border-white/10 dark:bg-gray-900"
  >
    <div class="flex items-start justify-between gap-4 border-b border-gray-100 px-4 py-4 sm:px-5 dark:border-white/5">
      <div class="min-w-0">
        <p class="text-[0.7rem] font-semibold uppercase tracking-wider text-violet-700 dark:text-violet-300">
          Topic syllabus
        </p>
        <h2 id="rm-modal-title" data-rm-title class="mt-0.5 break-words text-xl font-bold text-gray-900 dark:text-gray-100"></h2>
        <div class="mt-1.5 flex flex-wrap items-center gap-2">
          <span
            data-rm-difficulty
            hidden
            class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[0.7rem] font-semibold"
          >
          </span>
          <span
            data-rm-tier
            hidden
            class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 text-[0.7rem] font-semibold"
          >
          </span>
        </div>
      </div>
      <button
        type="button"
        data-rm-close
        aria-label="Close"
        class="inline-flex shrink-0 items-center gap-1.5 rounded-lg border border-gray-200 bg-gray-50 px-2 py-1 text-xs font-semibold uppercase leading-none tracking-wide text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-600 dark:border-white/10 dark:bg-white/5 dark:text-gray-400 dark:hover:bg-gray-800"
      >
        {/* X icon is the obvious click target for a mouse or touch at any size;
            the "Esc" text stays alongside it as the keyboard hint. */}
        <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" aria-hidden="true">
          <path d="M5 5l10 10M15 5L5 15" />
        </svg>
        <span>Esc</span>
      </button>
    </div>

    {/* Scrolls independently so a long syllabus never pushes the CTA off-screen. */}
    <div class="max-h-[58vh] overflow-y-auto">
      {/* Prerequisites callout (option 3A): populated by the island. */}
      <div
        data-rm-prereq-wrap
        hidden
        class="mx-4 mt-4 flex items-start gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 py-2.5 sm:mx-5 dark:border-blue-500/25 dark:bg-blue-500/10"
      >
        <svg class="mt-0.5 h-4 w-4 shrink-0 text-blue-600 dark:text-blue-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 2v6M8 6l4-4 4 4" />
          <rect x="4" y="10" width="16" height="10" rx="2" />
        </svg>
        <p class="text-sm text-gray-600 dark:text-gray-300">
          <span class="font-semibold text-gray-700 dark:text-gray-200">Learn first:</span>{' '}
          <span data-rm-prereq></span>
        </p>
      </div>

      <div class="px-4 py-4 sm:px-5">
        <p class="mb-3 text-sm text-gray-500 dark:text-gray-400">Concepts to learn:</p>
        {/*
          CSS multi-column, NOT a 2-column grid. A grid lays bullets out in ROWS,
          so a bullet that wraps to two lines stretches its whole row and leaves
          a gap opposite it. Columns flow independently: each one is packed on
          its own, and a wrap on the left cannot move anything on the right.
          Reading order stays sensible too, down the first column then the second.
        */}
        <ul data-rm-concepts class="sm:columns-2 sm:gap-x-8"></ul>
      </div>

      {/* Real headings of the linked note, so any section is one click away. */}
      {/* Main-track overview: the notes in this area, or one note's outline. */}
      <div data-rm-sections-wrap class="hidden border-t border-gray-100 px-4 py-4 sm:px-5 dark:border-white/5">
        <p data-rm-sections-label class="mb-3 text-sm text-gray-500 dark:text-gray-400"></p>
        <ul data-rm-sections class="flex flex-col gap-1"></ul>
      </div>
    </div>

    <div data-rm-footer class="hidden border-t border-gray-100 px-4 py-4 sm:px-5 dark:border-white/5">
      <a
        data-rm-link
        href="#"
        class="inline-flex items-center gap-2 rounded-lg bg-violet-600 px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-violet-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-violet-600 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
      >
        <span data-rm-link-text>Read the notes</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </dialog>

  {/* Node syllabus data for the island. */}
  <script type="application/json" data-rm-data set:html={JSON.stringify(nodeData)} />
  <script>
    import '@/components/roadmap';
  </script>
</Layout>

<style>
  .roadmap {
    overflow-x: auto;
  }

  /* ============================================================
     DETAILED VIEW - "Neural Pathway"
     The spine is a myelinated axon carrying a firing signal; branch
     connectors are dendrites ending in synaptic boutons; each track/topic
     is a neuron cell body with a difficulty nucleus. Optional cells wear a
     dashed amber membrane. Palettes are hand-tuned for light and dark.
     ============================================================ */

  /* --- Axon trunk (the spine) --- */
  .rm-trunk {
    fill: none;
    stroke: #c9bdf5; /* soft myelin sheath, light mode */
    stroke-width: 6;
    stroke-linecap: round;
  }
  .rm-trunk-core {
    fill: none;
    stroke: #a78bfa; /* lighter core (light mode) so the violet-600 spark reads on it */
    stroke-width: 2;
    stroke-linecap: round;
    opacity: 0.95;
  }
  .rm-ranvier {
    /* myelin gap banding the trunk between tracks: a short break in the sheath */
    stroke: #f6f5fb;
    stroke-width: 7;
    stroke-linecap: butt;
  }
  :global([data-theme='dark']) .rm-trunk {
    stroke: #4a3aa0;
  }
  :global([data-theme='dark']) .rm-trunk-core {
    stroke: #a78bfa;
  }
  :global([data-theme='dark']) .rm-ranvier {
    stroke: #0b0d17;
  }

  /* --- Action potential travelling the trunk --- */
  /* Light mode: a bright near-white violet spark so it stands out AGAINST the
     violet core as it moves (using the core colour made it invisible). A subtle
     ring makes the pulse legible on the pale sheath. */
  /* Light theme: a solid violet-600 spark, bright against the pale trunk. */
  .rm-signal {
    fill: #7c3aed;
    stroke: none;
  }
  .rm-signal-trail {
    opacity: 0.5;
  }
  :global([data-theme='dark']) .rm-signal {
    fill: #ffffff;
    stroke: none;
  }

  /* --- Dendrite connectors --- */
  .rm-edge {
    stroke: #7c3aed;
  }
  .rm-edge-dashed {
    stroke: #c4b5fd;
  }
  :global([data-theme='dark']) .rm-edge {
    stroke: #a78bfa;
  }
  :global([data-theme='dark']) .rm-edge-dashed {
    stroke: #6d28d9;
  }

  /* --- Synaptic boutons at dendrite terminals --- */
  .rm-bouton {
    fill: #cbc4e6; /* dormant terminal, faint violet (topic has no note yet) */
  }
  .rm-bouton-live {
    fill: #7c3aed; /* active synapse (topic has a note) */
  }
  :global([data-theme='dark']) .rm-bouton {
    fill: #3b4160;
  }
  :global([data-theme='dark']) .rm-bouton-live {
    fill: #8172d6;
  }

  /* --- Scroll reveal (fade + rise), triggered as the signal reaches a track ---
     Elements start hidden; when the island adds `.rm-track-in` to the SVG for a
     track, that track's nodes/edges/boutons fade + rise into place. The main
     cell (--ri:0) goes first, sub-topics cascade by their --ri index, so it
     reads as the axon signal branching into the dendrites. */
  .rm-reveal {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.5s ease,
      transform 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: calc(var(--ri, 0) * 0.09s);
  }
  .rm-edge.rm-reveal {
    transform: none; /* lines just fade; translating a path looks wrong */
  }
  /* Revealed: the SVG carries rm-track-in-<n>, matched per element's track. */
  :global(svg.rm-anim-ready) .rm-reveal.rm-shown {
    opacity: 1;
    transform: none;
  }
  /* Signals are gated the same way but by OPACITY ONLY (their motion is SMIL
     animateMotion, so a CSS transform would fight it). A track's sparks stay
     hidden until that track reveals, then fade in with it. */
  :global(svg.rm-anim-ready) .rm-signal-gated {
    opacity: 0;
    transition: opacity 0.5s ease;
  }
  :global(svg.rm-anim-ready) .rm-signal-gated.rm-shown {
    opacity: 1;
  }
  /* Before the island arms (or with JS off / reduced motion), show everything
     so the graph is never stuck invisible. */
  :global(svg:not(.rm-anim-ready)) .rm-reveal {
