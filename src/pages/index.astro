function featureMock(id: string): string {
  switch (id) {
    case 'roadmap': return roadmapMock();
    case 'notes': return notesMock();
    case 'quiz': return quizMock();
    case 'review': return reviewMock();
    case 'recall': return recallMock();
    case 'progress': return progressMock();
    default: return `<svg ${VB}>${surface()}</svg>`;
  }
}

