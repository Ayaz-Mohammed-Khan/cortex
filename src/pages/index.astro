  return `<svg ${VB} role="img" aria-label="A spaced-repetition review-due card">
    ${surface()}
    ${winHeader('Roadmap')}
    <rect x="26" y="78" width="408" height="170" rx="14" fill="color-mix(in srgb, var(--accent-500, #8b5cf6) 5%, white)" stroke="color-mix(in srgb, var(--accent-500, #8b5cf6) 30%, transparent)" stroke-width="1.5"/>
    <!-- animated clock -->
    <g class="lp-clock">
      <circle cx="66" cy="120" r="19" fill="color-mix(in srgb, var(--accent-500, #8b5cf6) 15%, transparent)"/>
      <circle cx="66" cy="120" r="11" fill="none" stroke="var(--accent-600, #7c3aed)" stroke-width="2.2"/>
      <line class="lp-clock-hand" x1="66" y1="120" x2="66" y2="112" stroke="var(--accent-600, #7c3aed)" stroke-width="2.2" stroke-linecap="round"/>
    </g>
    <text x="98" y="109" font-family="system-ui, sans-serif" font-size="15" font-weight="700" fill="var(--gray-800, #1f2937)">5 topics due for review</text>
    <rect x="98" y="122" width="196" height="8" rx="4" fill="var(--gray-400, #9ca3af)"/>
    <rect x="98" y="138" width="150" height="8" rx="4" fill="var(--gray-400, #9ca3af)"/>
