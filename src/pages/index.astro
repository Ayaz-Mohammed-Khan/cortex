/* ===========================================================================
 * SVG mocks of the real UI.
 *
 * Each helper returns an SVG string injected with `set:html`. They reproduce
 * the live surface: the quiz mock uses the same letter-marker option rows and
 * conic score ring, the review/recall cards use the same icons and chips, and
 * every colour is a palette TOKEN so the mock themes with the page. Animation
 * is added via CSS classes on SVG elements (see the page `<style>`), all gated
 * behind `prefers-reduced-motion`.
 *
 * Shared 460x320 viewBox; `lp-mock-*` classes are the animation hooks.
 * =========================================================================== */

const VB = 'viewBox="0 0 460 320" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"';

/** The full-bleed card surface behind every mock. */
function surface(): string {
  return `<rect x="0" y="0" width="460" height="320" rx="16" fill="var(--gray-50, #f9fafb)"/>`;
}

/** A faithful window header: brand dot-icon, title, and a close affordance. */
function winHeader(title: string, extra = ''): string {
  return (
    `<rect x="0" y="0" width="460" height="52" rx="16" fill="var(--gray-100, #f3f4f6)"/>` +
    `<rect x="0" y="36" width="460" height="16" fill="var(--gray-100, #f3f4f6)"/>` +
    `<rect x="20" y="15" width="24" height="22" rx="7" fill="var(--accent-100, #ede9fe)"/>` +
    `<path d="M27 26 l3 3 l7 -7" fill="none" stroke="var(--accent-600, #7c3aed)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>` +
    `<text x="54" y="31" font-family="system-ui, sans-serif" font-size="13" font-weight="700" fill="var(--gray-700, #374151)">${title}</text>` +
    extra +
    `<text x="432" y="31" text-anchor="middle" font-family="system-ui, sans-serif" font-size="13" fill="var(--gray-400, #9ca3af)">&#215;</text>`
  );
}

/** ROADMAP: real phase bands (true names + hues) with track chips. */
function roadmapMock(): string {
  const bands = phases.slice(0, 4).map((p, i) => {
    const y = 70 + i * 58;
    const chips = p.tracks
      .slice(0, 3)
      // Chips occupy the right of the band; the label column owns x=36..160.
      .map((t, j) => {
        const cx = 168 + j * 94;
        const w = Math.min(80, 40 + t.length * 2.6);
        const avail = i < 2; // first two phases "have notes" (filled)
        return (
          `<g class="lp-chip" style="--d:${(i * 3 + j) * 0.12}s">` +
          `<rect x="${cx}" y="${y - 13}" width="${w}" height="26" rx="13" fill="${avail ? 'color-mix(in srgb, ' + p.hue + ' 16%, white)' : 'var(--gray-100, #f3f4f6)'}" stroke="${avail ? p.hue : 'var(--gray-300, #d1d5db)'}" stroke-width="1.5" ${avail ? '' : 'stroke-dasharray="3 3"'}/>` +
          `<rect x="${cx + 13}" y="${y - 4}" width="${w - 26}" height="7" rx="3.5" fill="${avail ? p.hue : 'var(--gray-400, #9ca3af)'}"/>` +
          `</g>`
        );
      })
      .join('');
    // Shorten the one long phase name so it never collides with the chips.
    const shortName = p.name.length > 16 ? 'Core ML' : p.name;
    return (
      `<g class="lp-band" style="--d:${i * 0.1}s">` +
      `<rect x="20" y="${y - 24}" width="420" height="48" rx="11" fill="color-mix(in srgb, ${p.hue} 7%, transparent)"/>` +
      `<rect x="20" y="${y - 24}" width="4" height="48" rx="2" fill="${p.hue}"/>` +
      `<text x="36" y="${y - 2}" font-family="system-ui, sans-serif" font-size="9.5" font-weight="700" letter-spacing="0.4" fill="${p.hue}">${shortName.toUpperCase()}</text>` +
      `<text x="36" y="${y + 12}" font-family="system-ui, sans-serif" font-size="8.5" fill="var(--gray-400, #9ca3af)">Phase ${i + 1}</text>` +
      chips +
      `</g>`
    );
  });
  return `<svg ${VB} role="img" aria-label="The learning roadmap: phase bands with topic chips">
    ${surface()}
    ${winHeader('Learning roadmap')}
    ${bands.join('')}
  </svg>`;
}

