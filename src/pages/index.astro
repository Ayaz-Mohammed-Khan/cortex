    <rect x="26" y="70" width="408" height="222" rx="14" fill="color-mix(in srgb, var(--accent-500, #8b5cf6) 5%, white)" stroke="color-mix(in srgb, var(--accent-500, #8b5cf6) 30%, transparent)" stroke-width="1.5"/>
