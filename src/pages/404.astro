---
/**
 * Not-found page (task 19.3; Req 2.5).
 *
 * Served for any route that maps to no content entry. It reuses the full shell
 * (so navigation/search remain available) and contains a prominent link back
 * to the notes Section landing page.
 */
import { loadSite } from '@/lib/content';
import Layout from '@/components/Layout.astro';
import SeoHead from '@/components/SeoHead.astro';

export const prerender = true;

const site = await loadSite();
const notesLanding = '/' + site.tree.slug;
---

{/* Styling note: two actions, home (primary) and notes (secondary). */}

<Layout
  tree={site.tree}
  siteModel={site.siteModel}
  currentRoute="/404"
  sectionSlug={site.tree.slug}
>
  <SeoHead slot="head" displayName="Page not found" route="/404" site={Astro.site?.href} />

  <div class="mx-auto max-w-lg py-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-700 dark:text-accent-300">
      404
    </p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900 dark:text-gray-100">
      Page not found
    </h1>
    <p class="mt-3 text-gray-600 dark:text-gray-400">
      We couldn't find the page you were looking for.
    </p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center rounded-md bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 dark:bg-gray-100 dark:text-gray-900 dark:hover:bg-gray-300"
      >
        Back to home
      </a>
      <a
        href={notesLanding}
        class="inline-flex items-center rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-600 focus-visible:ring-offset-2 dark:border-white/15 dark:text-gray-200 dark:hover:bg-white/5"
      >
        Browse the notes
      </a>
    </div>
  </div>
</Layout>
