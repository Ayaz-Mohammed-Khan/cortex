# build output
dist/

# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# Python bytecode cache (diagram generator in ASSETS/)
__pycache__/
*.pyc

# IDEs setting folder
.idea/
.kiro/

# generated content mirror (synced from CONTENT_ROOT by scripts/sync-content.ts)
src/content/notes/

# ---------------------------------------------------------------------------
# Build-irrelevant files: kept locally, excluded from the repo so GitHub (and
# therefore the Cloudflare Pages build) only receives what the production build
# `npm ci && npm run build` (prebuild sync -> astro build -> pagefind) needs.
# These still live on disk, so local `npm run dev`, `npm run new`, and
# `npm test` keep working.
# ---------------------------------------------------------------------------

# tests (Cloudflare does not run them)
**/*.test.ts
**/*.property.test.ts
tests/
vitest.config.ts

# dev-only / local-authoring scripts (not part of the prod build chain)
scripts/dev.mjs
scripts/watch-content.ts
scripts/new-note.ts
/docs
