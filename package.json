{
  "name": "portfolio-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Static, content-driven portfolio website with a Markdown notes section.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs",
    "new": "node --experimental-strip-types scripts/new-note.ts",
    "prebuild": "node --experimental-strip-types scripts/sync-content.ts",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "audit:syllabus": "node --experimental-strip-types scripts/audit-syllabus.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.6",
    "katex": "^0.18.1",
    "pagefind": "^1.5.2",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-parse": "^9.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-math": "^6.0.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "4.13.0",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
